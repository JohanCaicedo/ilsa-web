---
import SmartImage from "../atoms/SmartImage.astro";
import { workTeamAreas } from "../../lib/team";
import { cn } from "../../lib/utils";

const tabIconPaths = {
    investigadores: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m18 0v-2a4 4 0 0 0-3-3.87M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm6 2a4 4 0 0 0 0-8",
    administracion: "M4 22h16M6 18V9l6-4 6 4v9M9 22v-6h6v6M9 12h.01M15 12h.01",
    comunicaciones: "M23 7l-7 5 7 5V7ZM1 5h15v14H1z",
    acompanamiento: "M8 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8 1a4 4 0 0 1 4 4v2H4v-2a4 4 0 0 1 4-4h8Z",
};

// Responsive grid based on member count
const getTeamGridClass = (memberCount: number) => {
    if (memberCount <= 1) return "max-w-sm justify-center";
    if (memberCount === 2) return "max-w-2xl sm:grid-cols-2";
    if (memberCount === 3) return "max-w-4xl grid-cols-2 md:grid-cols-3";
    if (memberCount === 4) return "max-w-5xl grid-cols-2 md:grid-cols-4";
    return "max-w-7xl grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5";
};

// Unique ID per component instance to avoid conflicts
const instanceId = `work-team-tabs-${Math.random().toString(36).slice(2, 9)}`;

// Find index of "administracion" to make it the default active tab
const defaultActiveIndex = workTeamAreas.findIndex(a => a.id === "administracion");
const activeIndex = defaultActiveIndex >= 0 ? defaultActiveIndex : 0;
---

<div
    id={instanceId}
    data-tabs-container
    class="rounded-3xl border border-white/60 bg-white/40 p-5 shadow-lg shadow-blue-900/10 backdrop-blur-xl"
    style={{
      display: workTeamAreas.length > 0 ? "flex" : "none",
      flexDirection: "column",
      gap: "1.5rem",
    }}
>
    <div class="flex flex-wrap justify-center gap-2 p-2" role="tablist" aria-label="Áreas del equipo de trabajo">
        {workTeamAreas.map((area, index) => (
            <button
                type="button"
                class:list={[
                    "work-team-tab inline-flex items-center gap-2 rounded-xl border px-4 py-2.5 text-sm font-semibold transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ilsa-blue)] focus-visible:ring-offset-2",
                    index === activeIndex
                        ? "border-[var(--ilsa-blue)] bg-[var(--ilsa-blue)] text-white shadow-lg shadow-blue-900/20"
                        : "border-white/40 bg-white/20 text-[var(--ilsa-text-dark)] hover:border-[var(--ilsa-blue)] hover:bg-white/60",
                ]}
                id={`work-team-tab-${area.id}-${instanceId}`}
                role="tab"
                aria-controls={`work-team-panel-${area.id}-${instanceId}`}
                aria-selected={index === activeIndex ? "true" : "false"}
                data-work-team-tab={area.id}
                tabindex={index === activeIndex ? "0" : "-1"}
            >
                <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align: -0.125em;">
                    <path d={tabIconPaths[area.id]} />
                </svg>
                <span>{area.title}</span>
            </button>
        ))}
    </div>

    <div
        id={`work-team-panels-container-${instanceId}`}
        class="grid"
        style="grid-template-areas: 'panel'"
        aria-live="polite"
    >
        {workTeamAreas.map((area, index) => (
            <section
                id={`work-team-panel-${area.id}-${instanceId}`}
                role="tabpanel"
                aria-labelledby={`work-team-tab-${area.id}-${instanceId}`}
                data-work-team-panel={area.id}
                class:list={[
                    "work-team-panel transition-opacity duration-500 ease-in-out",
                    index === activeIndex ? "opacity-100" : "opacity-0 pointer-events-none",
                ]}
                style="grid-area: panel"
                hidden={index !== activeIndex ? true : undefined}
                tabindex="0"
            >
                {area.members.length > 0 ? (
                    <div
                        class={cn(
                            "mx-auto grid w-full grid-cols-1 gap-6 sm:gap-7",
                            getTeamGridClass(area.members.length),
                        )}
                    >
                        {area.members.map((member) => (
                            <article
                                key?={member.id}
                                class="group relative h-[420px] w-full overflow-hidden rounded-[2rem] border border-white/60 bg-white/40 backdrop-blur-md shadow-lg transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-[var(--ilsa-blue)]/10"
                                data-team-id={member.id}
                                aria-label={`Perfil de ${member.name}`}
                            >
                                {/* Image Layer - Full height */}
                                <div class="relative h-full w-full overflow-hidden">
                                    <SmartImage
                                        src={member.image}
                                        alt={member.name}
                                        class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-110"
                                    />
                                    {/* Gradient overlay - sits ON TOP of image */}
                                    <div class="absolute inset-0 bg-gradient-to-t from-[var(--ilsa-blue-dark)]/80 via-[var(--ilsa-blue-dark)]/50 to-[var(--ilsa-blue-dark)]/30 mix-blend-multiply"></div>
                                </div>

                                {/* Content Layer - sits on top of image with gradient */}
                                <div class="absolute inset-x-0 bottom-0 flex flex-col justify-end p-5">
                                    <p class="mb-1 text-center text-xs font-bold uppercase tracking-widest text-white/90">{member.role}</p>
                                    <h3 class="text-center text-lg font-bold leading-tight text-white drop-shadow-md">{member.name}</h3>

                                    {/* Bio - hidden by default, visible on hover */}
                                    <div class="mt-3 overflow-hidden transition-all duration-500 ease-in-out">
                                        <p class="text-center text-sm leading-relaxed text-slate-200 line-clamp-3 group-hover:line-clamp-none group-hover:mt-2">
                                            {member.bio}
                                        </p>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </div>
                ) : (
                    <div class="mx-auto flex max-w-xl flex-col items-center justify-center rounded-2xl border border-white/60 bg-white/40 px-6 py-10 text-center backdrop-blur-md shadow-sm">
                        <p class="font-medium text-[var(--ilsa-text-gray)]">Próximamente conocerás a las personas que integran esta área.</p>
                    </div>
                )}
            </section>
        ))}
    </div>
</div>

<script>
    const initTabs = () => {
        // Find all containers on the page since the script might run once for multiple instances
        const containers = document.querySelectorAll<HTMLElement>('[data-tabs-container]');

        containers.forEach(root => {
            const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-work-team-tab]"));
            const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-work-team-panel]"));

            const selectTab = (id: string, focus = false) => {
                tabs.forEach((tab) => {
                    const isSelected = tab.dataset.workTeamTab === id;
                    const tabPanel = root.querySelector<HTMLElement>(`[data-work-team-panel="${tab.dataset.workTeamTab}"]`);

                    // Update tab state
                    tab.setAttribute("aria-selected", String(isSelected));
                    tab.tabIndex = isSelected ? 0 : -1;

                    // Update visual styles
                    if (isSelected) {
                        tab.classList.add("border-[var(--ilsa-blue)]", "bg-[var(--ilsa-blue)]", "text-white", "shadow-lg", "is-active");
                        tab.classList.remove("border-white/40", "bg-white/20", "text-[var(--ilsa-text-dark)]");
                    } else {
                        tab.classList.remove("border-[var(--ilsa-blue)]", "bg-[var(--ilsa-blue)]", "text-white", "shadow-lg", "is-active");
                        tab.classList.add("border-white/40", "bg-white/20", "text-[var(--ilsa-text-dark)]");
                    }

                    // Handle panel visibility and transitions
                    if (tabPanel) {
                        if (isSelected) {
                            tabPanel.hidden = false;
                            tabPanel.offsetHeight; // Force reflow
                            tabPanel.classList.remove("opacity-0", "pointer-events-none");
                            tabPanel.classList.add("opacity-100");
                            if (focus) tabPanel.focus();
                        } else {
                            tabPanel.classList.remove("opacity-100");
                            tabPanel.classList.add("opacity-0", "pointer-events-none");
                            setTimeout(() => {
                                if (!tabPanel.classList.contains("opacity-100")) {
                                    tabPanel.hidden = true;
                                }
                            }, 500);
                        }
                    }
                });
            };

            tabs.forEach((tab, index) => {
                tab.addEventListener("click", () => selectTab(tab.dataset.workTeamTab!));
                tab.addEventListener("keydown", (event: KeyboardEvent) => {
                    if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
                    event.preventDefault();

                    let nextIndex = index;
                    if (event.key === "Home") nextIndex = 0;
                    else if (event.key === "End") nextIndex = tabs.length - 1;
                    else if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
                    else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;

                    selectTab(tabs[nextIndex].dataset.workTeamTab!, true);
                });
            });

            // Set default state - use 'administracion' if available, otherwise first tab
            const defaultTab = tabs.find(t => t.dataset.workTeamTab === "administracion") || tabs[0];
            if (defaultTab) {
                selectTab(defaultTab.dataset.workTeamTab!);
            }
        });
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTabs);
    } else {
        initTabs();
    }
</script>

<style>
  .work-team-tab.is-active:hover {
    background-color: #314b79;
  }
  .work-team-tab.is-active {
    transform-origin: center;
  }
  .work-team-tab.is-active:hover {
    transform: scale(1.02);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  }
</style>