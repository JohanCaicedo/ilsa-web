---
import SkeletonLoader from "../atoms/SkeletonLoader.astro";

interface Props {
    type?: "article" | "card" | "text" | "author-header" | "author-card";
    class?: string;
    minHeight?: string; // Allow overriding min-height
}

const {
    type = "article",
    class: className,
    minHeight = "min-h-[50vh]",
} = Astro.props;
---

<div class={`wp-loader-container relative ${minHeight} ${className}`}>
    <!-- Skeleton Overlay -->
    <div
        class="wp-loader-skeleton absolute inset-0 z-10 bg-[var(--ilsa-bg-light)] pointer-events-none"
        aria-hidden="true"
    >
        <SkeletonLoader type={type} />
    </div>

    <!-- Real Content -->
    <div class="wp-loader-content h-full w-full">
        <slot />
    </div>
</div>

<style>
    /*
     * El contenido del CMS debe ser visible por defecto. En algunos navegadores
     * la animación puede pausarse o quedar cancelada durante la navegación, lo
     * que dejaba la página completa con opacity: 0.
     */
    .wp-loader-skeleton {
        display: none;
    }

    .wp-loader-content {
        opacity: 1;
        visibility: visible;
    }
</style>
