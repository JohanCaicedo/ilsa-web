---
import { cn } from "../../lib/utils";
import SmartImage from "../atoms/SmartImage.astro";

interface Props {
    name: string;
    profileImage: string;
    coverImage: string;
    class?: string;
}

const { name, profileImage, coverImage, class: className } = Astro.props;
---

<div
    class={cn(
        "relative aspect-square w-full rounded-3xl overflow-hidden group",
        "bg-white/40 backdrop-blur-md border border-white/60 shadow-lg",
        "hover:shadow-2xl hover:scale-[1.02] transition-all duration-500",
        className
    )}
>
    <!-- 1. BACKGROUND (Cover Image) -->
    <div class="absolute inset-0 z-0">
        <SmartImage
            src={coverImage}
            alt=""
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
        <!-- Brand tint overlay using ILSA Blue token -->
        <div class="absolute inset-0 bg-[var(--ilsa-blue)]/10 mix-blend-overlay pointer-events-none"></div>
        <!-- Depth overlay -->
        <div class="absolute inset-0 bg-black/10 mix-blend-multiply pointer-events-none"></div>
    </div>

    <!-- 2. FOREGROUND (Profile Image) - THE REVEAL -->
    <div
        class="absolute inset-0 z-10 transition-[clip-path] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
        style="clip-path: circle(0% at 50% 50%);"
    >
        <SmartImage
            src={profileImage}
            alt={name}
            class="w-full h-full object-cover"
        />
    </div>

    <style>
        .group:hover > div[style*="clip-path"] {
            clip-path: circle(150% at 50% 50%) !important;
        }
    </style>

    <!-- Gradient Overlay using brand tokens -->
    <div
        class="absolute inset-0 bg-gradient-to-t from-[var(--ilsa-blue)]/80 via-transparent to-transparent opacity-40 group-hover:opacity-60 transition-opacity duration-300 z-20 pointer-events-none"
    >
    </div>

    <!-- Text contrast gradient -->
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--ilsa-blue-dark)]/90 via-[var(--ilsa-blue-dark)]/30 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

    <!-- Contenedor de texto centrado - Only visible on hover -->
    <div
        class="absolute inset-x-0 bottom-0 z-30 p-6 flex flex-col items-center text-center opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300"
    >
        <p class="text-xs md:text-sm font-bold tracking-widest text-white uppercase mb-1 drop-shadow-sm">
            Columnista
        </p>
        <h3 class="text-2xl font-bold tracking-tight text-white drop-shadow-md">
            {name}
        </h3>
    </div>
</div>