---
interface Props {
    name: string;
    profileImage: string;
    coverImage: string;
    class?: string;
}

import SmartImage from "../atoms/SmartImage.astro";

const { name, profileImage, coverImage, class: className } = Astro.props;
---

<div
    class="relative aspect-square w-full rounded-3xl overflow-hidden shadow-[0_8px_30px_rgba(78,124,206,0.1)] hover:shadow-[0_15px_40px_rgba(78,124,206,0.25)] active:scale-95 transition-all duration-500 group border border-[#4e7cce]/20 select-none cursor-pointer bg-white/5"
>
    <!-- 1. BACKGROUND (Cover Image) -->
    <div class="absolute inset-0 z-0">
        <div
            class="w-full h-full opacity-90 transition-transform duration-700 group-hover:scale-110"
        >
            <SmartImage
                src={coverImage}
                alt=""
                class="w-full h-full object-cover"
            />
        </div>
        <div class="absolute inset-0 bg-[#4E7CCE]/10 mix-blend-overlay"></div>
        <div class="absolute inset-0 bg-black/10 mix-blend-multiply"></div>
    </div>

    <!-- 2. FOREGROUND (Profile Image) - THE REVEAL -->
    <div
        class="absolute inset-0 z-10 transition-[clip-path] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
        style="clip-path: circle(0% at 50% 50%);"
    >
        <SmartImage
            src={profileImage}
            alt={name}
            class="w-full h-full object-cover"
        />
    </div>

    <style>
        .group:hover > div[style*="clip-path"] {
            clip-path: circle(150% at 50% 50%) !important;
        }
    </style>

    <!-- Gradient Overlay -->
    <div
        class="absolute inset-0 bg-gradient-to-t from-[#4e7cce]/80 via-transparent to-transparent opacity-40 group-hover:opacity-60 transition-opacity duration-300 z-20 pointer-events-none"
    >
    </div>

    <!-- Gradiente de fondo para contraste del texto -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#183069]/90 via-[#183069]/30 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

    <!-- Contenedor de texto centrado - Only visible on hover -->
    <div
        class="absolute inset-x-0 bottom-0 z-30 p-6 flex flex-col items-center text-center opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300"
    >
        <p class="text-xs md:text-sm font-bold tracking-widest text-[#f9f9f9] uppercase mb-1 drop-shadow-sm">
            Columnista
        </p>
        <h3 class="text-2xl font-bold tracking-tight text-[#f9f9f9] drop-shadow-md">
            {name}
        </h3>
    </div>
</div>