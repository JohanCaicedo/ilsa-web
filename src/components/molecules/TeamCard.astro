---
/**
 * TeamCard Component
 * Reusable card for team members in /nosotros page
 * Supports executive and board variants with gold badge for first item
 */
import type { TeamMember } from "../../lib/team";

interface Props {
    member: TeamMember;
    /** Card variant determines styling */
    variant?: "executive" | "board";
    /** Index used to show gold badge on first item */
    index?: number;
    /** Additional CSS classes */
    class?: string;
}

const {
    member,
    variant = "executive",
    index = 0,
    class: className = "",
} = Astro.props;

const isFirst = index === 0;
const cardId = `team-card-${member.id}`;
---

<div
    class:list={[
        "interactive-card relative group rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl cursor-pointer h-[400px] md:h-[450px] w-full focus-visible:ring-2 focus-visible:ring-[#4e7cce] focus-visible:ring-offset-2 outline-none",
        isFirst && "ring-2 ring-white/40 shadow-[#4e7cce]/20",
        className,
    ]}
    data-team-id={member.id}
    data-card-id={cardId}
    tabindex="0"
    role="button"
    aria-label={`Ver información de ${member.name}`}
>
    <img
        class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-110"
        src={member.image}
        alt={member.name}
        width="400"
        height="450"
        loading="lazy"
    />

    <!-- Gold Badge (Liquid Glass) - First item only -->
    {isFirst && (
        <div class="absolute top-4 right-4 z-20 bg-white/20 backdrop-blur-md border border-white/40 rounded-full p-2.5 shadow-lg group-hover:bg-white/30 transition-colors duration-300 pointer-events-none">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                class="drop-shadow-[0_0_8px_rgba(250,204,21,0.6)]"
            >
                <defs>
                    <linearGradient id={`gold-grad-${member.id}`} x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#FEF08A" />
                        <stop offset="40%" stop-color="#F59E0B" />
                        <stop offset="100%" stop-color="#A16207" />
                    </linearGradient>
                </defs>
                <polygon
                    fill={`url(#gold-grad-${member.id})`}
                    stroke="#FEF08A"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                    points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                />
            </svg>
        </div>
    )}

    <!-- Gradient Overlay -->
    <div
        class:list={[
            "absolute inset-0 bg-gradient-to-t opacity-90 transition-opacity duration-300",
            isFirst
                ? "from-[#0b1b42] via-[#102352]/50 to-transparent"
                : "from-[#183069] via-[#183069]/40 to-transparent",
        ]}
    />

    <!-- Content -->
    <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
        <p
            class:list={[
                "font-bold text-xs tracking-widest uppercase mb-1 opacity-80 group-hover:opacity-100 text-center shrink-0",
                isFirst ? "text-[#a1c4ff]" : "text-[#efefef]",
            ]}
        >
            {member.role}
        </p>
        <div class="h-14 md:h-16 flex items-center justify-center w-full mb-2 shrink-0">
            <h3
                class:list={[
                    "font-bold text-center text-white leading-tight drop-shadow-md",
                    member.name.length > 20 ? "text-lg md:text-xl" : "text-xl md:text-2xl",
                ]}
            >
                {member.name}
            </h3>
        </div>
        <div class="h-0 group-hover:h-auto overflow-hidden transition-all duration-500 opacity-0 group-hover:opacity-100 text-center">
            <p class="text-slate-300 text-sm mt-2">
                {member.bio || ""}
            </p>
        </div>
    </div>
</div>