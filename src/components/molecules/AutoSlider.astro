---
/**
 * AutoSlider Component
 * A reusable image slider with automatic cycling and smooth transitions.
 */
import SmartImage from "../atoms/SmartImage.astro";

interface Props {
    class?: string;
    srcs: string[];
    alt?: string;
    width?: number;
    height?: number;
    priorityIndex?: number;
}

const {
    class: className = "",
    srcs = [],
    alt = "Imagen de galería",
    width = 1200,
    height = 500,
    priorityIndex = 0,
} = Astro.props;

const shouldUseSlider = srcs.length > 1;
---

<auto-slider
    class:list={["relative block w-full h-[400px] md:h-[500px] rounded-[2.5rem] overflow-hidden shadow-2xl shadow-blue-900/10 group", className]}
    data-use-slider={shouldUseSlider}
>
    {
        srcs.map((src, index) => (
            <SmartImage
                src={src}
                alt={alt}
                width={width}
                height={height}
                class={`absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-all duration-1000 slider-image ${index === 0 ? "opacity-100" : "opacity-0"}`}
                data-slider-image
                priority={priorityIndex === index}
            />
        ))
    }
</auto-slider>

<style>
    .slider-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .slider-image:not(:first-child) {
        opacity: 0;
    }

    .slider-image:first-child {
        opacity: 1;
    }
</style>

<script>
    class AutoSlider extends HTMLElement {
        connectedCallback() {
            const imgs = this.querySelectorAll("img[data-slider-image]");
            const useSlider = this.dataset.useSlider === "true";

            if (imgs.length <= 1 || !useSlider) return;

            let currentIndex = 0;

            const nextSlide = () => {
                const prev = imgs[currentIndex];
                prev.classList.remove("opacity-100");
                prev.classList.add("opacity-0");

                currentIndex = (currentIndex + 1) % imgs.length;

                const next = imgs[currentIndex];
                next.classList.remove("opacity-0");
                next.classList.add("opacity-100");

                setTimeout(nextSlide, 4000 + Math.random() * 3000);
            };

            setTimeout(nextSlide, 4000 + Math.random() * 3000);
        }
    }

    // Idempotent definition: avoid error when multiple <auto-slider> exist on same page
    if (!customElements.get("auto-slider")) {
        customElements.define("auto-slider", AutoSlider);
    }
</script>
