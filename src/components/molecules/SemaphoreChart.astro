---
import { cn } from "../../lib/utils";

interface SemaphoreData {
  compatible: number;
  alerta: number;
  riesgoGrave: number;
  erosion: number;
  total: number;
}

interface Props {
  data: SemaphoreData;
  class?: string;
}

const { data, class: className } = Astro.props;

const categories = [
  {
    key: 'compatible',
    label: 'Compatible',
    count: data.compatible,
    color: '#22c55e',
    colorLight: '#dcfce7',
    colorText: '#166534',
    colorBorder: '#bbf7d0',
    description: 'Preserva las garantías',
    percentage: ((data.compatible / data.total) * 100).toFixed(1),
  },
  {
    key: 'alerta',
    label: 'Alerta',
    count: data.alerta,
    color: '#eab308',
    colorLight: '#fef9c3',
    colorText: '#854d0e',
    colorBorder: '#fef08a',
    description: 'Posible deterioro',
    percentage: ((data.alerta / data.total) * 100).toFixed(1),
  },
  {
    key: 'riesgoGrave',
    label: 'Riesgo grave',
    count: data.riesgoGrave,
    color: '#f97316',
    colorLight: '#ffedd5',
    colorText: '#9a3412',
    colorBorder: '#fed7aa',
    description: 'Amenaza concreta y sustentada',
    percentage: ((data.riesgoGrave / data.total) * 100).toFixed(1),
  },
  {
    key: 'erosion',
    label: 'Erosión democrática',
    count: data.erosion,
    color: '#ef4444',
    colorLight: '#fef2f2',
    colorText: '#991b1b',
    colorBorder: '#fecaca',
    description: 'Reducción efectiva de garantías',
    percentage: ((data.erosion / data.total) * 100).toFixed(1),
  },
];

const criticalTotal = data.riesgoGrave + data.erosion;
const criticalPercentage = ((criticalTotal / data.total) * 100).toFixed(1);
const criticalStartPercent = Number(categories[0].percentage) + Number(categories[1].percentage); // compatible + alerta
---

<div class={cn("space-y-6", className)}>
  <!-- Header con resumen crítico - Enhanced Liquid Glass -->
  <div class="relative bg-white/60 backdrop-blur-xl border border-white/70 rounded-3xl p-6 md:p-8 text-center overflow-hidden shadow-lg shadow-slate-200/50">
    <!-- Subtle gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-red-50/50 via-transparent to-orange-50/50 pointer-events-none"></div>
    <div class="relative flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8">
      <div class="text-center flex-1">
        <div class="text-3xl md:text-4xl lg:text-5xl font-black bg-gradient-to-r from-red-600 to-orange-600 bg-clip-text text-transparent leading-none">{criticalPercentage}%</div>
        <div class="text-xs md:text-sm text-red-700 font-medium mt-1 uppercase tracking-wide">Riesgo grave + Erosión</div>
      </div>
      <div class="hidden md:block w-px h-12 bg-gradient-to-b from-transparent via-red-200/50 to-transparent"></div>
      <div class="text-center flex-1">
        <div class="text-2xl md:text-3xl lg:text-4xl font-black text-red-600 leading-none whitespace-nowrap">{criticalTotal} de {data.total}</div>
        <div class="text-xs md:text-sm text-red-700 font-medium mt-1 uppercase tracking-wide">Episodios críticos</div>
      </div>
      <div class="hidden md:block w-px h-12 bg-gradient-to-b from-transparent via-red-200/50 to-transparent"></div>
      <div class="text-center flex-1">
        <div class="text-3xl md:text-4xl lg:text-5xl font-black text-slate-600 leading-none">{data.total}</div>
        <div class="text-xs md:text-sm text-slate-500 font-medium mt-1 uppercase tracking-wide">Total documentados</div>
      </div>
    </div>
    <!-- Accent line -->
    <div class="absolute bottom-0 left-1/4 right-1/4 h-1 bg-gradient-to-r from-transparent via-red-500/30 to-transparent rounded-full"></div>
  </div>

  <!-- Barras del semáforo - Enhanced with Liquid Glass -->
  <div class="space-y-4" role="img" aria-label={`Distribución de valoraciones de los ${data.total} episodios: Compatible ${categories[0].percentage}%, Alerta ${categories[1].percentage}%, Riesgo grave ${categories[2].percentage}%, Erosión democrática ${categories[3].percentage}%`}>
    {categories.map((cat) => (
      <div class="group relative" data-animate="slide-up">
        <!-- Etiqueta y porcentaje -->
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-3">
            <span
              class="w-3 h-3 rounded-full flex-shrink-0 shadow-sm"
              style={`background-color: ${cat.color}; box-shadow: 0 0 0 2px ${cat.color}33;`}
            ></span>
            <span class="font-semibold text-slate-800 text-sm md:text-base">{cat.label}</span>
            <span
              class="text-xs text-slate-500 font-medium px-2.5 py-1 rounded-full backdrop-blur-sm border"
              style={`background-color: ${cat.colorLight}; color: ${cat.colorText}; border-color: ${cat.colorBorder}`}
            >
              {cat.percentage}%
            </span>
          </div>
          <span class="font-mono font-bold text-slate-600 text-sm md:text-base">{cat.count}</span>
        </div>

        <!-- Barra de progreso - Liquid Glass style -->
        <div class="relative h-3 md:h-4 bg-slate-100/50 rounded-full overflow-hidden backdrop-blur-sm group-hover:shadow-lg group-hover:shadow-[${cat.color}]40 transition-shadow duration-300" style="min-width: 0;">
          <div
            class="h-full rounded-full transition-all duration-1000 ease-out origin-left relative"
            style={{ width: '0%', backgroundColor: cat.color }}
            data-final-width={`${cat.percentage}%`}
          >
            <!-- Shine effect on bar -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent rounded-full"></div>
          </div>

          <!-- Tooltip en hover -->
          <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-1.5 bg-slate-900/90 backdrop-blur-sm text-white text-xs rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 whitespace-nowrap">
            {cat.description} — {cat.count} episodios ({cat.percentage}%)
          </div>
        </div>
      </div>
    ))}

    <!-- Línea de umbral crítico -->
    <div class="relative mt-8">
      <div
        class="absolute top-1/2 w-px h-8 -translate-y-1/2 bg-gradient-to-b from-orange-500/60 to-orange-500/0"
        style={`left: ${criticalStartPercent}%`}
      ></div>
      <div class="absolute -top-7 left-0 right-0 text-left md:text-center pointer-events-none">
        <span class="text-[10px] font-bold text-orange-600 uppercase tracking-wider bg-white/90 backdrop-blur-sm px-2 py-0.5 rounded-full border border-orange-200/50">Umbral crítico</span>
      </div>
    </div>
  </div>

  <!-- Leyenda descriptiva - Enhanced cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 pt-10" data-animate="stagger">
    {categories.map((cat) => (
      <div
        class={cn(
          "relative p-4 md:p-5 rounded-2xl text-center transition-all duration-300 group hover:shadow-xl hover:-translate-y-1 overflow-hidden",
          `bg-[${cat.colorLight}]`, `border-[${cat.colorBorder}]`
        )}
      >
        <!-- Top accent line -->
        <div class="absolute top-0 left-0 right-0 h-1" style={{backgroundColor: cat.color}}></div>
        <div class="w-3 h-3 rounded-full mx-auto mb-3 relative" style={`background-color: ${cat.color}; box-shadow: 0 0 0 4px ${cat.color}22;`}>
          <div class="absolute inset-0 rounded-full bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
        </div>
        <p class="text-center text-xs md:text-sm font-bold" style={{color: cat.colorText}}>{cat.label}</p>
        <p class="text-center text-[10px] md:text-xs mt-1 text-slate-500 leading-snug">{cat.description}</p>
        <p class="text-center text-[10px] md:text-xs mt-2 font-mono font-medium" style={{color: cat.color}}>{cat.count} episodios · {cat.percentage}%</p>
      </div>
    ))}
  </div>

  <!-- Nota metodológica -->
  <p class="text-center text-xs text-slate-500 pt-4 border-t border-slate-100">
    Valoraciones sobre {data.total} episodios computables. Fuente: Observatorio de la Democracia, ILSA. El semáforo describe el expediente reunido; no mide "cuánta democracia se ha perdido" ni es una muestra estadística del país.
  </p>
</div>

<script>
  // Animar las barras al hacer scroll
  function animateBars() {
    const bars = document.querySelectorAll('[data-final-width]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const bar = entry.target as HTMLElement;
          const finalWidth = bar.getAttribute('data-final-width');
          if (finalWidth) {
            bar.style.width = finalWidth;
          }
          observer.unobserve(bar);
        }
      });
    }, { threshold: 0.3, rootMargin: '0px 0px -50px 0px' });

    bars.forEach((bar) => observer.observe(bar));
  }

  // Animaciones de entrada escalonadas
  function animateEntrance() {
    const elements = document.querySelectorAll('[data-animate]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = el.dataset.animate === 'stagger' ? index * 80 : 0;
          setTimeout(() => {
            el.classList.add('animate-in');
          }, delay);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    elements.forEach((el) => observer.observe(el));
  }

  // Ejecutar en carga y en transiciones de Astro
  document.addEventListener('astro:page-load', () => {
    animateBars();
    animateEntrance();
  });
  document.addEventListener('DOMContentLoaded', () => {
    animateBars();
    animateEntrance();
  });
</script>

<style>
  [data-animate] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  [data-animate].animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  [data-animate="slide-up"] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  [data-animate="slide-up"].animate-in {
    opacity: 1;
    transform: translateY(0);
  }
</style>