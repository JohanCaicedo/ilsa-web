---
/**
 * ColumnistCard Component
 * Card for opinion columnists in /opinion page
 */
import SmartImage from "../atoms/SmartImage.astro";

interface Props {
  name: string;
  profileImage: string;
  coverImage: string;
  class?: string;
}

const {
  name,
  profileImage,
  coverImage,
  class: className = "",
} = Astro.props;
---

<div
  class="interactive-card relative group rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl cursor-pointer h-[400px] md:h-[450px] w-full focus-visible:ring-2 focus-visible:ring-[#4e7cce] focus-visible:ring-offset-2 outline-none transition-all duration-300 hover:-translate-y-2 hover:border-[#4e7cce]/50 hover:shadow-[#4e7cce]/10"
  data-team-id={name}
  tabindex="0"
  role="button"
  aria-label={`Ver información de ${name}`}
>
  <div class="absolute inset-0 h-full w-full">
    <SmartImage
      src={coverImage}
      alt={name}
      width="400"
      height="450"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
    />
  </div>

  <!-- Gradient Overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-[#0b1b42] via-[#102352]/60 to-transparent opacity-90 transition-opacity duration-300"
  />

  <!-- Content -->
  <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
    <h3
      class="font-bold text-center text-white leading-tight drop-shadow-md text-xl md:text-2xl"
    >
      {name}
    </h3>
  </div>
</div>
