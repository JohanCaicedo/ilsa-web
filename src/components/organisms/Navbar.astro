---
// src/components/organisms/Navbar.astro
import NavLink from "../atoms/navbar/NavLink.astro";
import NavDropdown from "../atoms/navbar/NavDropdown.astro";
import NavButton from "../atoms/navbar/NavButton.astro";
import LiquidContainer from "../experimental/LiquidContainer.astro";
import {
    HIDE_SENSITIVE_AUTHORS,
    SENSITIVE_AUTHORS,
} from "../../lib/presentationConfig";
import { collectionsConfig } from "../../lib/collections";
import { authorsConfig } from "../../lib/authors";

const navStructure = [
    {
        type: "link",
        text: "Multimedia",
        href: "/multimedia",
    },
    {
        type: "dropdown",
        text: "Nosotros",
        href: "/nosotros",
        items: [
            {
                label: "Asamblea",
                href: "#",
            },
            {
                label: "Dirección Ejecutiva",
                href: "/nosotros#direccion-ejecutiva",
            },
            {
                label: "Equipo de trabajo",
                href: "/nosotros#equipo-trabajo",
            },
            { label: "Historia", href: "/nosotros#historia" },
            {
                label: "Identidad Visual",
                href: "/nosotros#identidad-visual",
            },
            { label: "Junta Directiva", href: "/nosotros#junta-directiva" },
            { label: "Misión", href: "/nosotros#mision" },
            { label: "Visión", href: "/nosotros#vision" },
        ],
    },
    {
        type: "link",
        text: "Noticias",
        href: "/noticias",
    },
    {
        type: "dropdown",
        text: "Opinión",
        href: "/opinion",
        // Mapping specific authors based on configuration
        items: Object.entries(authorsConfig)
            .filter(
                ([slug]) =>
                    !HIDE_SENSITIVE_AUTHORS ||
                    !SENSITIVE_AUTHORS.includes(slug),
            )
            .map(([slug, author]) => ({
                label: author.name,
                href: `/opinion/${slug}`,
            }))
            .sort((a, b) => a.label.localeCompare(b.label)),
    },
    {
        type: "dropdown",
        text: "Publicaciones",
        href: "/publicaciones", // Default or list page? Using generic one or first
        items: Object.entries(collectionsConfig).map(([slug, config]) => ({
            label: config.title,
            href: `/publicaciones/${slug}`,
        })),
    },
];
---

<div class="fixed top-0 left-0 right-0 z-[60] p-4" transition:persist="navbar">
    <LiquidContainer
        intensity="medium"
        clipContent={false}
        frosted={true}
        class="w-full flex items-center px-4 md:px-6 lg:px-10 py-3 rounded-full text-slate-800 text-sm shadow-lg shadow-slate-200/50 ios-glass-fix transition-all duration-300"
    >
        <nav class="flex items-center w-full">
            <a
                href="/"
                id="ilsa-logo"
                class="shrink-0 flex items-center pr-4 md:pr-6 lg:pr-10"
                aria-label="ILSA Home"
            >
                <img
                    src="https://api.ilsa.org.co/wp-content/uploads/2025/08/ILSA-Logo-2025-16.svg"
                    alt="ILSA Logo"
                    class="h-12 w-auto object-contain"
                />
            </a>

            <!-- Desktop Menu -->
            <div
                class="hidden lg:flex items-center gap-4 xl:gap-8 font-medium h-10 ml-2 lg:ml-4 xl:ml-8"
            >
                {
                    navStructure.map((item) =>
                        item.type === "link" ? (
                            <NavLink href={item.href!} text={item.text} />
                        ) : (
                            <NavDropdown
                                text={item.text}
                                items={item.items!}
                                href={item.href}
                            />
                        ),
                    )
                }
            </div>

            <!-- Spacer to push actions to right -->
            <div class="flex-grow"></div>

            <!-- Desktop Actions -->
            <div class="hidden lg:flex items-center gap-2 xl:gap-4">
                <a
                    href="/actividades"
                    class="group relative px-4 xl:px-6 py-2 rounded-full font-medium text-[#4e7cce] text-sm transition-all duration-300 transform hover:scale-110 hover:text-white hover:bg-[#4e7cce] hover:shadow-lg border border-[#4e7cce] flex items-center gap-2 ml-2 xl:ml-4"
                >
                    <span>Actividades</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                        ></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </a>
                <a
                    href="/donaciones"
                    class="group relative px-4 xl:px-6 py-2 rounded-full font-medium text-white text-sm transition-all duration-300 transform hover:scale-110 flex items-center gap-2 bg-[#4e7cce] hover:bg-[#375a9e] shadow-[0_0_15px_rgba(78,124,206,0.5)] hover:shadow-[0_0_25px_rgba(78,124,206,0.7)]"
                >
                    <span>Donaciones</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path
                            d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"
                        ></path>
                    </svg>
                </a>
            </div>

            <!-- Mobile Toggle -->
            <div class="lg:hidden ml-auto flex items-center">
                <button
                    id="menuToggle"
                    class="text-slate-700 hover:text-[#4a7dbf] transition-colors p-3 relative z-[60]"
                    aria-label="Abrir menú"
                    aria-expanded="false"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </nav>
    </LiquidContainer>

    <!-- Mobile Menu Overlay - Full Screen Liquid Glass -->
    <div
        id="mobileMenu"
        class="fixed inset-0 z-[100] hidden flex-col bg-white/10 backdrop-blur-3xl border border-white/20 shadow-[0_8px_32px_0_rgba(0,0,0,0.12)] p-6 md:p-10 overflow-y-auto transition-all duration-500 ease-out ios-glass-fix touch-scroll"
        role="dialog"
        aria-modal="true"
        aria-label="Menú principal"
    >
        <!-- Header: Logo + Close Button -->
        <div class="flex justify-between items-center mb-10">
            <a href="/" class="shrink-0" aria-label="ILSA Home">
                <img
                    src="https://api.ilsa.org.co/wp-content/uploads/2025/08/ILSA-Logo-2025-16.svg"
                    alt="ILSA Logo"
                    class="h-10 w-auto object-contain"
                />
            </a>
            <button
                id="closeMenu"
                class="p-2 text-slate-600 hover:text-slate-900 transition-colors rounded-lg hover:bg-white/50"
                aria-label="Cerrar menú"
            >
                <svg
                    class="w-7 h-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M18 6L6 18M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Navigation Accordion -->
        <nav class="flex-1 flex flex-col gap-4" id="mobileNav">
            {
                navStructure.map((item, index) => (
                    <div class="mobile-nav-item" style={`--delay: ${index * 80}ms`}>
                        {item.type === "link" ? (
                            <a
                                href={item.href}
                                class="block py-4 text-2xl font-bold text-slate-900 hover:text-[#4a7dbf] transition-colors border-b border-white/30"
                            >
                                {item.text}
                            </a>
                        ) : (
                            <details class="group" open={false}>
                                <summary
                                    class="flex justify-between items-center py-4 text-2xl font-bold text-slate-900 list-none cursor-pointer border-b border-white/30 focus:outline-none focus:ring-2 focus:ring-[#4e7cce] focus:ring-offset-2 focus:ring-offset-white/10"
                                >
                                    {item.text}
                                    <svg
                                        class="w-6 h-6 text-slate-500 transition-transform duration-300 group-open:rotate-180 flex-shrink-0 ml-4"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        viewBox="0 0 24 24"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M6 9l6 6 6-6"></path>
                                    </svg>
                                </summary>
                                <div class="pl-2 mt-4 flex flex-col gap-2 border-l border-white/30 animate-in fade-in slide-in-from-top-2 duration-300">
                                    {item.href ? (
                                        <a
                                            href={item.href}
                                            class="text-lg text-[#4a7dbf] hover:text-[#375a9e] font-medium pb-2 border-b border-white/20"
                                        >
                                            Ver todo →
                                        </a>
                                    ) : null}
                                    {item.items?.map((sub) => (
                                        <a
                                            href={sub.href}
                                            class="py-2 text-lg text-slate-700 hover:text-[#4a7dbf] transition-colors"
                                        >
                                            {sub.label}
                                        </a>
                                    ))}
                                </div>
                            </details>
                        )}
                    </div>
                ))
            }
        </nav>

        <!-- Footer CTAs -->
        <div class="mt-8 pt-8 border-t border-white/30 flex flex-col gap-3">
            <NavButton
                variant="secondary"
                href="/actividades"
                class="w-full justify-center py-4 text-lg"
            >
                Actividades
            </NavButton>
            <div
                class="rainbow w-full relative z-0 bg-white/15 overflow-hidden p-[1px] flex items-center justify-center rounded-full hover:scale-[1.02] hover:shadow-[0_0_24px_rgba(78,124,206,0.5)] transition duration-300 active:scale-100 group"
            >
                <a
                    href="/donaciones"
                    class="w-full px-6 py-4 text-lg text-white rounded-full font-medium bg-slate-900/90 backdrop-blur block text-center relative z-10"
                >
                    Donaciones
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Event Delegation for Mobile Menu
    // We bind to the document ONCE to survive Astro's View Transitions and to avoid adding repeated listeners
    // to the persistent #menuToggle button when navigating between pages.

    // Flag to ensure we only register the global listener once.
    if (!(window as any).hasNavbarListenerRegistered) {
        document.addEventListener("click", (e) => {
            const mobileMenu = document.getElementById("mobileMenu");
            const menuToggle = document.getElementById("menuToggle");
            const closeMenu = document.getElementById("closeMenu");

            if (!mobileMenu) return;

            const isMenuToggle = !!(e.target as Element).closest("#menuToggle");
            const isCloseBtn = !!(e.target as Element).closest("#closeMenu");
            const isClickInsideMenu = !!(e.target as Element).closest("#mobileMenu");

            // 1. Open menu
            if (isMenuToggle) {
                mobileMenu.classList.remove("hidden");
                mobileMenu.classList.add("flex");
                document.body.style.overflow = "hidden";
                menuToggle?.setAttribute("aria-expanded", "true");
                menuToggle?.setAttribute("aria-label", "Cerrar menú");
                return;
            }

            // 2. Close via X button
            if (isCloseBtn) {
                mobileMenu.classList.add("hidden");
                mobileMenu.classList.remove("flex");
                document.body.style.overflow = "";
                menuToggle?.setAttribute("aria-expanded", "false");
                menuToggle?.setAttribute("aria-label", "Abrir menú");
                return;
            }

            // 3. Close on link click (navigation)
            const isMobileLink = !!(e.target as Element).closest("#mobileMenu a");
            if (isMobileLink && !mobileMenu.classList.contains("hidden")) {
                mobileMenu.classList.add("hidden");
                mobileMenu.classList.remove("flex");
                document.body.style.overflow = "";
                menuToggle?.setAttribute("aria-expanded", "false");
                menuToggle?.setAttribute("aria-label", "Abrir menú");
                return;
            }

            // 4. Close on click outside (backdrop)
            if (!isClickInsideMenu && !isMenuToggle && !mobileMenu.classList.contains("hidden")) {
                mobileMenu.classList.add("hidden");
                mobileMenu.classList.remove("flex");
                document.body.style.overflow = "";
                menuToggle?.setAttribute("aria-expanded", "false");
                menuToggle?.setAttribute("aria-label", "Abrir menú");
            }
        });

        (window as any).hasNavbarListenerRegistered = true;
    }

    // Long Press Easter Egg Activation (Mobile & Desktop)
    document.addEventListener("astro:page-load", () => {
        const logo = document.getElementById("ilsa-logo");
        if (!logo) return;

        let pressTimer: number | null = null;
        const PRESS_DURATION = 2000; // 2 seconds delay

        const startPress = (e: Event) => {
            // Check if mobile (Game is currently disabled on mobile)
            const isMobile =
                window.matchMedia("(max-width: 768px)").matches ||
                "ontouchstart" in window;
            if (isMobile) return;

            // Only accept primary mouse button
            if (e instanceof MouseEvent && e.button !== 0) return;

            // Clear any existing timer just in case
            if (pressTimer) clearTimeout(pressTimer);

            pressTimer = window.setTimeout(() => {
                // Success!
                // console.log("Long Press detected! Activating Easter Egg...");

                // Haptic Feedback (Vibration)
                if (window.navigator && window.navigator.vibrate) {
                    window.navigator.vibrate(200); // 200ms vibration
                }

                // Dispatch Activation Event
                const activationEvent = new CustomEvent("activate-easter-egg");
                window.dispatchEvent(activationEvent);

                pressTimer = null;

                // Prevent the subsequent click from navigating
                logo.addEventListener(
                    "click",
                    (clickEvent) => {
                        clickEvent.preventDefault();
                        clickEvent.stopImmediatePropagation();
                    },
                    { once: true, capture: true },
                );
            }, PRESS_DURATION);
        };

        const cancelPress = () => {
            if (pressTimer) {
                clearTimeout(pressTimer);
                pressTimer = null;
            }
        };

        // Inputs
        logo.addEventListener("mousedown", startPress);
        logo.addEventListener("touchstart", startPress, { passive: true });

        // Cancellations
        logo.addEventListener("mouseup", cancelPress);
        logo.addEventListener("mouseleave", cancelPress);
        logo.addEventListener("touchend", cancelPress);
        logo.addEventListener("touchcancel", cancelPress);
        logo.addEventListener("touchmove", cancelPress, { passive: true }); // Cancel if user scrolls

        // Prevent Context Menu on Mobile (allows holding the image without popup)
        logo.addEventListener("contextmenu", (e) => {
            // Only prevent if we want to enforce the secret (optional, but cleaner)
            e.preventDefault();
        });
    });
</script>

<style>
    @keyframes rotate {
        100% {
            transform: rotate(1turn);
        }
    }

    .rainbow::before {
        content: "";
        position: absolute;
        z-index: -1;
        left: -50%;
        top: -50%;
        width: 200%;
        height: 200%;
        background-position: 100% 50%;
        background-repeat: no-repeat;
        filter: blur(4px);
        background-image: linear-gradient(
            90deg,
            transparent,
            #4e7cce,
            #5e3b69,
            #4e7cce,
            transparent
        );
        animation: rotate 3s linear infinite;
        background-size: 50% 50%;
    }
</style>