---
interface Props {
    color?: string;
    size?: string;
    speed?: string; // e.g. "20s"
    visible?: boolean;
    class?: string;
    persistId?: string; // Deterministic ID for View Transitions persistence
}

const {
    color = "var(--ilsa-blue)",
    size = "400px",
    speed = "25s",
    visible = true,
    class: className,
    persistId = "orb-default",
} = Astro.props;

if (!visible) {
    return null;
}

const uniqueId = persistId;
---

<div
    class={`fixed inset-0 pointer-events-none overflow-hidden z-[-1] select-none ${className}`}
>
    <!-- Removed fixed opacity-60 class to allow dynamic control via script/style -->
    <!-- Restored: Original CSS Blur with forced GPU hardware acceleration -->
    <div
        id={uniqueId}
        class="absolute rounded-full blur-[80px] webkit-blur-fix"
        style={`
        width: ${size};
        height: ${size};
        background-color: ${color};
        /* Initial position center */
        left: 50%;
        top: 50%;
        transform: translate3d(-50%, -50%, 0);
        opacity: 0.6; /* Start at max opacity */
    `}
        data-speed={speed}
    >
    </div>
</div>

<script define:vars={{ uniqueId }}>
    (function () {
        let moveAnimation = null;
        let pulseAnimation = null;
        let isAnimating = false;

        function init() {
            const orb = document.getElementById(uniqueId);
            if (!orb) return;

            if (orb.dataset.isAnimating === "true") return;
            orb.dataset.isAnimating = "true";
            isAnimating = true;

            const speedStr = orb.getAttribute("data-speed") || "20s";
            const baseDuration = parseFloat(speedStr) * 1000 || 20000;

            function move() {
                if (!isAnimating) return;
                const orbEl = document.getElementById(uniqueId);
                if (!orbEl) return;

                const w = window.innerWidth;
                const h = window.innerHeight;
                const randomX = (Math.random() - 0.5) * w * 1.5;
                const randomY = (Math.random() - 0.5) * h * 1.5;
                const duration = baseDuration * (0.8 + Math.random() * 0.4);

                moveAnimation = orbEl.animate(
                    {
                        transform: `translate(calc(-50% + ${randomX}px), calc(-50% + ${randomY}px))`,
                    },
                    {
                        duration: duration,
                        easing: "ease-in-out",
                        fill: "forwards",
                    },
                );

                moveAnimation.onfinish = move;
            }

            function pulse() {
                if (!isAnimating) return;
                const orbEl = document.getElementById(uniqueId);
                if (!orbEl) return;

                const maxOpacity = 0.6;
                const minOpacity = 0.05;
                const targetOpacity =
                    minOpacity + Math.random() * (maxOpacity - minOpacity);
                const duration = 3000 + Math.random() * 5000;

                pulseAnimation = orbEl.animate(
                    {
                        opacity: targetOpacity,
                    },
                    {
                        duration: duration,
                        easing: "ease-in-out",
                        fill: "forwards",
                    },
                );

                pulseAnimation.onfinish = pulse;
            }

            move();
            pulse();
        }

        function cleanup() {
            isAnimating = false;
            if (moveAnimation) {
                moveAnimation.cancel();
                moveAnimation = null;
            }
            if (pulseAnimation) {
                pulseAnimation.cancel();
                pulseAnimation = null;
            }
        }

        // Cleanup on Astro View Transitions (before new page prepares)
        document.addEventListener("astro:before-preparation", cleanup);
        // Also cleanup on page unload
        window.addEventListener("pagehide", cleanup);

        init();
    })();
</script>