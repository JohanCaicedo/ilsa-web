</Layout>

<script>
    const setupHeroParallax = () => {
        const hero = document.querySelector<HTMLElement>(
            "[data-hero-parallax]",
        );
        const layers = hero?.querySelectorAll<HTMLElement>(
            "[data-parallax-layer]",
        );
        const foreground = hero?.querySelector<HTMLElement>(
            "[data-parallax-foreground]",
        );
        const desktop = window.matchMedia("(min-width: 768px)");
        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        );
        let frame: number | undefined;
        let pointerX = 0;
        let pointerY = 0;
        let currentPointerX = 0;
        let currentPointerY = 0;

        if (!hero || !layers?.length || hero.dataset.parallaxReady === "true")
            return;
        hero.dataset.parallaxReady = "true";

        const reset = () => {
            layers.forEach((layer) => {
                layer.style.transform = "translate3d(0, 0, 0)";
            });
            if (foreground) foreground.style.transform = "translate3d(0, 0, 0)";
        };
        const render = () => {
            frame = undefined;
            if (reducedMotion.matches) return reset();

            const bounds = hero.getBoundingClientRect();
            const progress = Math.max(
                -1,
                Math.min(
                    1,
                    (bounds.top + bounds.height / 2 - window.innerHeight / 2) /
                        window.innerHeight,
                ),
            );
            if (!desktop.matches) {
                layers.forEach((layer) => {
                    layer.style.transform = "translate3d(0, 0, 0)";
                });
                if (foreground)
                    foreground.style.transform = `translate3d(0, ${progress * -24}px, 0)`;
                return;
            }
            const ease = 0.12;
            currentPointerX += (pointerX - currentPointerX) * ease;
            currentPointerY += (pointerY - currentPointerY) * ease;
            layers.forEach((layer) => {
                const speed = Number(layer.dataset.parallaxSpeed || 0);
                const movementFactor = speed === 0 ? 0 : 0.8;
                layer.style.transform = `translate3d(${currentPointerX * movementFactor}px, ${progress * speed * -100 + currentPointerY * movementFactor}px, 0)`;
            });
            if (foreground) {
                const scrollOffset = progress * -42;
                foreground.style.transform = `translate3d(${currentPointerX}px, ${scrollOffset + currentPointerY}px, 0)`;
            }
            if (
                Math.abs(pointerX - currentPointerX) > 0.1 ||
                Math.abs(pointerY - currentPointerY) > 0.1
            )
                requestRender();
        };
        const requestRender = () => {
            if (frame === undefined) frame = requestAnimationFrame(render);
        };
        const onPointerMove = (event: PointerEvent) => {
            if (!desktop.matches || reducedMotion.matches) return;
            const bounds = hero.getBoundingClientRect();
            pointerX =
                ((event.clientX - bounds.left) / bounds.width - 0.5) * 28;
            pointerY =
                ((event.clientY - bounds.top) / bounds.height - 0.5) * 18;
            requestRender();
        };
        const onPointerLeave = () => {
            pointerX = 0;
            pointerY = 0;
            requestRender();
        };

        requestRender();
        window.addEventListener("scroll", requestRender, { passive: true });
        window.addEventListener("resize", requestRender, { passive: true });
        hero.addEventListener("pointermove", onPointerMove, { passive: true });
        hero.addEventListener("pointerleave", onPointerLeave, {
            passive: true,
        });
        desktop.addEventListener("change", requestRender);
        reducedMotion.addEventListener("change", requestRender);
    };

    document.addEventListener("astro:page-load", setupHeroParallax);
    setupHeroParallax();

    const setupAuthorsToggle = () => {
        const toggle = document.querySelector<HTMLButtonElement>(
            "[data-authors-toggle]",
        );
        const extraAuthors = document.querySelectorAll<HTMLElement>(
            "[data-extra-author]",
        );
        if (!toggle || toggle.dataset.ready === "true") return;
        toggle.dataset.ready = "true";
        toggle.addEventListener("click", () => {
            const expanded = toggle.getAttribute("aria-expanded") === "true";
            extraAuthors.forEach((author) =>
                author.classList.toggle("hidden", expanded),
            );
            toggle.setAttribute("aria-expanded", String(!expanded));
            toggle.textContent = expanded ? "Ver más" : "Mostrar menos";
        });
    };

    document.addEventListener("astro:page-load", setupAuthorsToggle);
    setupAuthorsToggle();
</script>
