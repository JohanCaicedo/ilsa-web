---
import Layout from "../../layouts/Layout.astro";
import HeroParallax from "../../components/organisms/HeroParallax";

export const prerender = true;

const title = "Paramilitarismo del siglo XXI | ILSA";
const description =
    "Esta obra analiza el fenómeno del paramilitarismo en el siglo XXI, sus relaciones de poder, economías políticas y las estructuras que lo sostienen.";
const sigloUrl =
    "https://libreriasiglo.com/317261-paramilitarismo-del-siglo-xxi-actualidad-del-orden-contrainsurgente-en-colombia";
const buscalibreUrl =
    "https://www.buscalibre.com.co/libros/search?q=9789588341903";
const pdfUrl =
    "https://api.ilsa.org.co/wp-content/uploads/2026/10/Paramilitarismo-_del_siglo_XXI_Textos_de_Aqui_y_Ahora_N18.pdf";
const coverUrl =
    "https://api.ilsa.org.co/wp-content/uploads/2026/10/Paramilitarismo-del-siglo-XXI-ID-1.webp";
const launchReelUrl =
    "https://www.instagram.com/reel/DclmVvKyvyd/?mdxt=dXI3dDJ6M3NlcHp5";
const launchEmbedUrl = "https://www.instagram.com/reel/DclmVvKyvyd/embed";
const opinionArticleUrl = "/2026/10/pistola-al-cinto/";
const launchImages = [
    {
        src: "https://api.ilsa.org.co/wp-content/uploads/2026/10/Paramilitarismo-en-el-siglo-XXI-Lanzamiento-1.webp",
        alt: "Fotografía del lanzamiento de Paramilitarismo del siglo XXI",
    },
    {
        src: "https://api.ilsa.org.co/wp-content/uploads/2026/10/Paramilitarismo-en-el-siglo-XXI-Lanzamiento-2.webp",
        alt: "Fotografía del lanzamiento de Paramilitarismo del siglo XXI",
    },
];

const chapters = [
    {
        title: "Paramilitarismo del siglo XXI. Actualidad del orden contrainsurgente en Colombia",
        authors: ["Francisco Javier Toloza"],
    },
    {
        title: "Contrainsurgencia en las universidades. Estudios de casos de penetración paramilitar en la educación superior en Colombia",
        authors: ["Stephani Ortiz Muñoz", "Miguel Ángel Beltrán"],
    },
    { title: "¿Negociar la Paz con las AUC?", authors: ["Andrew Thomson"] },
    {
        title: "Las disputas por la “verdad” sobre el paramilitarismo en Colombia: análisis del Informe Final de la CEV",
        authors: ["Mary Cruz Ortega Hernández", "Sergio De Zubiria Samper"],
    },
    {
        title: "El conflicto social y armado en Palenque de San Basilio",
        authors: ["Aiden Salgado Cassiani"],
    },
    {
        title: "De Justicia y Paz a la Jurisdicción Especial para la Paz: Balance de los sistemas de justicia creados en transiciones políticas de Colombia",
        authors: ["Jhon Jairo Espinosa", "José E. Hinestroza"],
    },
    {
        title: "Paramilitarismo y género: La percepción de los cuerpos en el contexto del conflicto armado colombiano",
        authors: ["María Paula García Lizarazo", "Laura Sofía Quiñones Ladino"],
    },
    {
        title: "El caso del Ejército Gaitanista de Colombia en torno a la persistencia actual del paramilitarismo. Un debate de carácter político",
        authors: ["Cristian Alejandro Córdoba"],
    },
];

const productDetails = [
    ["ISBN", "978-958-8341-90-3"],
    ["Peso", "0.38 kg"],
    ["Tamaño", "16 × 23 cm"],
    ["Número de páginas", "336"],
    ["Año de edición", "2026"],
    ["Edición", "1"],
    ["Encuadernación", "Rústica"],
    ["Referencia", "ILS10081"],
    ["Colección", "Textos de Aquí y Ahora"],
    ["Código de barras", "9789588341903"],
];

const authors = [
    {
        name: "MIGUEL ÁNGEL BELTRÁN VILLEGAS",
        bio: "Sociólogo, licenciado en Ciencias Sociales, magíster en Ciencias Sociales y doctor en Ciencias Sociales. Es miembro del comité científico internacional de la revista Contrahistorias. Pensamiento crítico y contracultura, y docente del Departamento de Sociología de la Universidad Nacional de Colombia.",
    },
    {
        name: "CRISTIAN ALEJANDRO CÓRDOBA",
        bio: "Politólogo y estudiante de la Maestría en Estudios Políticos del IEPRI de la Universidad Nacional de Colombia. Analista de riesgo en la Unidad Nacional de Protección. Integrante del semillero Régimen Político, Conflicto y Paz y del Grupo Interdisciplinario de Estudios Políticos y Sociales Theseus.",
    },
    {
        name: "MARY CRUZ ORTEGA HERNÁNDEZ",
        bio: "Abogada, magíster y doctora en Derechos Humanos. Candidata al doctorado en Filosofía de la Universidad Complutense de Madrid. Docente de la Escuela Superior de Administración Pública (ESAP), Colombia, e integrante del Comité Editorial de la Revista Líneas de Fuga.",
    },
    {
        name: "SERGIO DE ZUBIRÍA SAMPER",
        bio: "Licenciado en Filosofía y Letras, especialista en Filosofía y Bioética, magíster en Filosofía Política y doctor en Filosofía Política, con posdoctorado en Bioética. Profesor titular del Doctorado de la Universidad del Bosque. Integró la Comisión Histórica del Conflicto y sus Víctimas.",
    },
    {
        name: "JHON J. ESPINOSA SILVA",
        bio: "Abogado, especialista en Derecho Procesal y magíster en Derecho Procesal. Candidato a doctor en Derecho. Exasesor de la implementación normativa del Acuerdo Final de Paz entre el Gobierno Nacional de Colombia y las FARC-EP.",
    },
    {
        name: "MARÍA PAULA GARCÍA LIZARAZO",
        bio: "Estudiante de Ciencia Política de la Universidad Nacional. Monitora del curso Sistema Político Colombiano. Integrante del semillero Régimen Político, Conflicto y Paz y del Grupo Interdisciplinario de Estudios Políticos y Sociales Theseus.",
    },
    {
        name: "JOSÉ E. HINESTROZA PALACIOS",
        bio: "Abogado, especialista en Derecho Penal y Administrativo, magíster en Instituciones Jurídicos Penales y Derecho Internacional Humanitario y DD.HH. Suplente del Tribunal de Paz en la Jurisdicción Especial para la Paz.",
    },
    {
        name: "STEPHANI ORTIZ MUÑOZ",
        bio: "Licenciada en Ciencias Sociales, especialista en Pedagogía y maestranda en Pedagogías Críticas e Intervención Socioeducativa. Docente de aula, feminista y defensora de Derechos Humanos en la Fundación Lazos de Dignidad.",
    },
    {
        name: "LAURA SOFÍA QUIÑONES LADINO",
        bio: "Politóloga de la Universidad Nacional de Colombia, estudiante de Antropología y de la especialización en DD.HH. y Paz. Integrante del semillero Régimen Político, Conflicto y Paz y del Grupo Interdisciplinario de Estudios Políticos y Sociales Theseus.",
    },
    {
        name: "AIDEN JOSÉ SALGADO CASSIANI",
        bio: "Licenciado en Educación Básica con Énfasis en Ciencias Sociales, magíster en Ciencias Políticas y en Estudios Afrocolombianos. Profesor, palenquero y activista cimarrón. Escritor en medios alternativos.",
    },
    {
        name: "ANDREW THOMSON",
        bio: "Licenciado en Ciencias Políticas y Relaciones Internacionales, máster y doctor en Relaciones Internacionales. Profesor titular en la Universidad Queen’s de Belfast e investigador del Instituto para la Paz, la Seguridad y la Justicia Globales.",
    },
    {
        name: "FRANCISCO TOLOZA FUENTES",
        bio: "Politólogo, magíster en Sociología y doctorando en Derecho. Experto en Historia del Conflicto Armado en Colombia y Teoría Política. Docente del Departamento de Ciencia Política de la Universidad Nacional de Colombia y asesor de la Dirección Ejecutiva de ILSA.",
    },
];

const bookSchema = {
    "@context": "https://schema.org",
    "@type": "Book",
    name: "Paramilitarismo del siglo XXI. Actualidad del orden contrainsurgente en Colombia",
    description,
    image: coverUrl,
    isbn: "9789588341903",
    inLanguage: "es",
    numberOfPages: 336,
    bookFormat: "https://schema.org/Paperback",
    datePublished: "2026",
    author: [
        { "@type": "Person", name: "Francisco Toloza Fuentes" },
        { "@type": "Person", name: "Stephani Ortiz Muñoz" },
        { "@type": "Person", name: "Jorge Freytter-Florian" },
    ],
    publisher: { "@type": "Organization", name: "ILSA" },
    offers: {
        "@type": "Offer",
        price: "55000",
        priceCurrency: "COP",
        url: sigloUrl,
    },
};
---

<Layout
    title={title}
    width="wide"
    seo={{
        title,
        metaDesc: description,
        opengraphTitle: title,
        opengraphDescription: description,
        opengraphImage: { sourceUrl: coverUrl },
        twitterImage: { sourceUrl: coverUrl },
    }}
    breadcrumbs={[
        { label: "Publicaciones", href: "/publicaciones" },
        {
            label: "Paramilitarismo del siglo XXI",
            href: "/publicaciones/paramilitarismo-del-siglo-xxi",
        },
    ]}
>
    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(bookSchema)}
    />
    <article class="pb-12">
        <HeroParallax />

        <section
            class="relative mx-auto mt-8 max-w-[1200px]"
            aria-label="Opciones de compra"
        >
            <div
                class="pointer-events-none absolute -left-20 top-1/2 -z-10 h-64 w-64 -translate-y-1/2 rounded-full bg-[var(--ilsa-blue)]/10 blur-[100px]"
            >
            </div>
            <div class="grid gap-4 md:grid-cols-3">
                <a
                    href={sigloUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex min-h-40 flex-col rounded-3xl border border-[#ea4e6f]/30 bg-[#ea4e6f]/10 p-6 shadow-lg shadow-[#ea4e6f]/10 backdrop-blur-3xl transition-all duration-300 hover:-translate-y-1 hover:bg-[#ea4e6f]/15 hover:shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#ea4e6f]"
                >
                    <span
                        class="text-xs font-bold uppercase tracking-[.14em] text-[#b93655]"
                        >Edición impresa</span
                    >
                    <span
                        class="mt-2 block text-xl font-bold text-[var(--ilsa-text-dark)] transition-colors duration-300 group-hover:text-[#ea4e6f]"
                        >Comprar en Librería Siglo del Hombre <span
                            class="inline-block transition-transform group-hover:translate-x-1"
                            >→</span
                        ></span
                    >
                </a>
                <div
                    class="group flex min-h-40 flex-col rounded-3xl border border-[#b66c45]/30 bg-[#b66c45]/10 p-6 shadow-lg shadow-[#b66c45]/10 backdrop-blur-3xl transition-all duration-300 hover:-translate-y-1 hover:bg-[#b66c45]/15 hover:shadow-2xl"
                >
                    <span
                        class="text-xs font-bold uppercase tracking-[.14em] text-[#8a4f31]"
                        >Edición impresa</span
                    >
                    <span
                        class="mt-2 block text-xl font-bold text-[var(--ilsa-text-dark)] transition-colors duration-300 group-hover:text-[#9f5837]"
                        >Comprar en Buscalibre</span
                    >
                    <span
                        class="mt-auto pt-2 block text-sm font-medium text-[var(--ilsa-text-gray)]"
                        >Próximamente</span
                    >
                </div>
                <div
                    class="group flex min-h-40 flex-col rounded-3xl border border-[#023b7e]/30 bg-[#023b7e]/10 p-6 shadow-sm shadow-[#023b7e]/10 backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:bg-[#023b7e]/15 hover:shadow-2xl"
                >
                    <span
                        class="text-xs font-bold uppercase tracking-[.14em] text-[#023b7e]"
                        >Libro digital</span
                    >
                    <span
                        class="mt-2 block text-xl font-bold text-[var(--ilsa-text-dark)] transition-colors duration-300 group-hover:text-[#023b7e]"
                        >Comprar en Amazon</span
                    >
                    <span
                        class="mt-auto pt-2 block text-sm font-medium text-[var(--ilsa-text-gray)]"
                        >Próximamente</span
                    >
                </div>
            </div>
        </section>

        <section
            class="mx-auto mt-16 grid max-w-[1200px] gap-8 md:grid-cols-[.8fr_1.2fr]"
            aria-labelledby="presentation-title"
        >
            <div>
                <p
                    class="text-sm font-bold uppercase tracking-[.14em] text-[var(--ilsa-blue)]"
                >
                    Presentación
                </p><h2
                    id="presentation-title"
                    class="mt-3 text-3xl font-bold text-[var(--ilsa-text-dark)]"
                >
                    Una lectura necesaria para el presente
                </h2>
            </div>
            <div class="space-y-4 text-[var(--ilsa-text-gray)]">
                <p>
                    Este libro analiza el orden contrainsurgente como un
                    entramado de relaciones de poder y no como la simple suma de
                    organizaciones armadas. Sus ocho capítulos abordan sus
                    economías políticas, sus expresiones en universidades y
                    territorios étnicos, las disputas por la verdad y los
                    sistemas de justicia.
                </p><p>
                    Con ello, se suma a una larga trayectoria de ILSA de
                    investigación, formación y debate público sobre las
                    condiciones que sostienen el paramilitarismo y sus
                    transformaciones contemporáneas.
                </p><a
                    href={pdfUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex font-bold text-[var(--ilsa-blue)] underline decoration-2 underline-offset-4 hover:text-[var(--ilsa-blue-dark)]"
                    >Leer presentación, créditos e índice en PDF ↗</a
                >
            </div>
        </section>

        <section
            class="mx-auto mt-16 max-w-[1200px] border-y border-[var(--ilsa-blue)]/20 py-10"
            aria-labelledby="contents-title"
        >
            <p
                class="text-sm font-bold uppercase tracking-[.14em] text-[var(--ilsa-blue)]"
            >
                Contenido
            </p>
            <h2
                id="contents-title"
                class="mt-3 text-3xl font-bold text-[var(--ilsa-text-dark)]"
            >
                Artículos
            </h2>
            <ol class="mt-8 grid gap-x-10 md:grid-cols-2">
                {
                    chapters.map((chapter, index) => (
                        <li class="grid grid-cols-[auto_1fr] gap-x-4 border-t border-[var(--ilsa-blue)]/20 py-5 text-[var(--ilsa-text-gray)]">
                            <>
                                <span class="font-bold text-[var(--ilsa-blue)]">
                                    {String(index + 1).padStart(2, "0")}
                                </span>
                                <div>
                                    <>
                                        <h3 class="font-semibold leading-snug text-[var(--ilsa-text-dark)]">
                                            {chapter.title}
                                        </h3>
                                        <p class="mt-2 text-sm leading-relaxed text-[var(--ilsa-text-gray)]">
                                            {chapter.authors.join(" · ")}
                                        </p>
                                    </>
                                </div>
                            </>
                        </li>
                    ))
                }
            </ol>
        </section>

        <section
            class="relative mx-auto mt-16 max-w-[1200px]"
            aria-labelledby="authors-title"
        >
            <div
                class="pointer-events-none absolute -right-24 top-0 -z-10 h-80 w-80 rounded-full bg-[var(--ilsa-blue)]/10 blur-[110px]"
            >
            </div>
            <p
                class="text-sm font-bold uppercase tracking-[.14em] text-[var(--ilsa-blue)]"
            >
                Colaboradores
            </p>
            <h2
                id="authors-title"
                class="mt-3 text-3xl font-bold text-[var(--ilsa-text-dark)]"
            >
                Sobre los autores
            </h2>
            <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                {
                    authors.map((author, index) => (
                        <article
                            class:list={[
                                "group relative overflow-hidden rounded-3xl border border-white/20 bg-white/10 p-5 shadow-lg backdrop-blur-3xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl",
                                index >= 4 && "hidden",
                            ]}
                            data-extra-author
                        >
                            <div
                                class={`absolute -right-10 -top-10 h-28 w-28 rounded-full blur-3xl transition-opacity duration-500 ${index % 3 === 0 ? "bg-[var(--ilsa-blue)]/20" : index % 3 === 1 ? "bg-[var(--ilsa-mujeres-light)]/30" : "bg-[var(--ilsa-blue-light)]/40"}`}
                            />
                            <div class="relative flex items-start gap-4">
                                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/60 bg-white/40 text-xs font-black text-[var(--ilsa-blue)] backdrop-blur-md">
                                    {String(index + 1).padStart(2, "0")}
                                </span>
                                <h3 class="pt-1 text-sm font-black leading-snug tracking-[.08em] text-[var(--ilsa-text-dark)]">
                                    {author.name}
                                </h3>
                            </div>
                            <p class="relative mt-5 border-t border-white/50 pt-4 text-sm leading-relaxed text-[var(--ilsa-text-gray)]">
                                {author.bio}
                            </p>
                        </article>
                    ))
                }
            </div>
            <div class="mt-6 flex justify-center">
                <button
                    type="button"
                    class="rounded-xl border border-white/60 bg-white/40 px-5 py-2.5 text-sm font-semibold text-[var(--ilsa-blue)] shadow-sm backdrop-blur-md transition-all hover:-translate-y-0.5 hover:bg-white/60 focus:outline-none focus:ring-2 focus:ring-[var(--ilsa-blue)]"
                    data-authors-toggle
                    aria-expanded="false"
                >
                    Ver más
                </button>
            </div>
        </section>

        <section
            class="relative mx-auto mt-16 max-w-[1200px]"
            aria-labelledby="launch-title"
        >
            <div
                class="pointer-events-none absolute -left-24 top-1/3 -z-10 h-72 w-72 rounded-full bg-[#ea4e6f]/10 blur-[110px]"
            >
            </div>
            <p
                class="text-sm font-bold uppercase tracking-[.14em] text-[var(--ilsa-blue)]"
            >
                Lanzamiento
            </p>

            <!-- Video de Instagram en formato horizontal -->
            <div class="mt-8 mx-auto w-full max-w-[960px]">
                <div
                    class="relative flex flex-col overflow-hidden rounded-3xl border border-white/40 bg-white/30 p-3 shadow-xl backdrop-blur-3xl transition-all duration-300 hover:shadow-2xl"
                >
                    <div
                        class="relative w-full aspect-video min-h-[360px] sm:min-h-[460px] md:min-h-[540px] overflow-hidden rounded-2xl bg-slate-900/5 shadow-inner"
                    >
                        <iframe
                            src={launchEmbedUrl}
                            width="100%"
                            height="100%"
                            frameborder="0"
                            scrolling="no"
                            allowtransparency="true"
                            allow="encrypted-media"
                            class="h-full w-full border-0"
                            title="Video del lanzamiento en Instagram"></iframe>
                    </div>
                    <div
                        class="mt-3 flex items-center justify-between px-2 py-1"
                    >
                        <div
                            class="flex items-center gap-2 text-xs font-semibold text-[var(--ilsa-text-dark)]"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-[#ea4e6f]"
                                aria-hidden="true"
                            >
                                <rect
                                    width="20"
                                    height="20"
                                    x="2"
                                    y="2"
                                    rx="5"
                                    ry="5"></rect>
                                <path
                                    d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                                ></path>
                                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"
                                ></line>
                            </svg>
                            <span>Video oficial en Instagram</span>
                        </div>
                        <a
                            href={launchReelUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1 text-xs font-bold text-[var(--ilsa-blue)] transition-colors hover:text-[var(--ilsa-blue-dark)] hover:underline"
                        >
                            <span>Ver en Instagram</span>
                            <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Fotografías del lanzamiento (una al lado de la otra) -->
            <div class="mt-8 grid gap-6 sm:grid-cols-2">
                {
                    launchImages.map((image) => (
                        <a
                            href={image.src}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group relative block overflow-hidden rounded-3xl border border-white/40 bg-white/30 p-3 shadow-xl backdrop-blur-3xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
                            title="Click para ver la imagen completa"
                        >
                            <div class="relative aspect-[16/10] w-full overflow-hidden rounded-2xl bg-slate-100">
                                <img
                                    src={image.src}
                                    alt={image.alt}
                                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <span class="absolute right-3 top-3 inline-flex items-center rounded-full border border-white/40 bg-black/40 px-2.5 py-1 text-[11px] font-medium text-white backdrop-blur-md opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                                    Ver completa ↗
                                </span>
                            </div>
                        </a>
                    ))
                }
            </div>
        </section>

        <section
            class="mx-auto mt-12 max-w-[1200px]"
            aria-labelledby="details-title"
        >
            <p
                class="text-sm font-bold uppercase tracking-[.14em] text-[var(--ilsa-blue)]"
            >
                Ficha editorial
            </p>
            <h2
                id="details-title"
                class="mt-3 text-3xl font-bold text-[var(--ilsa-text-dark)]"
            >
                Textos de Aquí y Ahora, N.º 18
            </h2>
            <dl
                class="mt-7 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-[var(--ilsa-blue)]/20 pt-7 text-sm md:grid-cols-3"
            >
                {
                    productDetails.map(([label, value]) => (
                        <div>
                            <>
                                <dt class="text-[var(--ilsa-text-gray)]">
                                    {label}
                                </dt>
                                <dd class="mt-1 font-semibold text-[var(--ilsa-text-dark)]">
                                    {value}
                                </dd>
                            </>
                        </div>
                    ))
                }
            </dl>
        </section>

        <!-- Contenido de interés / Para profundizar -->
        <section
            class="relative mx-auto mt-16 max-w-[1200px]"
            aria-labelledby="opinion-title"
        >
            <div
                class="pointer-events-none absolute -right-20 top-1/2 -z-10 h-72 w-72 -translate-y-1/2 rounded-full bg-[var(--ilsa-blue)]/10 blur-[110px]"
            >
            </div>
            <p
                class="text-sm font-bold uppercase tracking-[.14em] text-[var(--ilsa-blue)]"
            >
                Contenido de interés
            </p>
            <h2
                id="opinion-title"
                class="mt-3 text-3xl font-bold text-[var(--ilsa-text-dark)]"
            >
                Para profundizar en la temática
            </h2>
            <p class="mt-2 max-w-2xl text-[var(--ilsa-text-gray)]">
                Artículo de opinión y análisis de coyuntura por Francisco Toloza, autor e investigador de la publicación.
            </p>

            <div class="mt-8">
                <a
                    href={opinionArticleUrl}
                    class="group relative block overflow-hidden rounded-3xl border border-white/40 bg-white/30 p-6 md:p-8 shadow-xl backdrop-blur-3xl transition-all duration-300 hover:-translate-y-1 hover:bg-white/40 hover:shadow-2xl focus:outline-none focus:ring-2 focus:ring-[var(--ilsa-blue)]"
                >
                    <div
                        class="relative flex flex-col justify-between gap-6 md:flex-row md:items-center"
                    >
