                                class="inline-flex items-center gap-2 rounded-2xl bg-[var(--ilsa-blue)] px-5 py-3 text-sm font-bold text-white shadow-md shadow-[var(--ilsa-blue)]/20 transition-all duration-300 group-hover:bg-[var(--ilsa-blue-dark)] group-hover:shadow-lg group-hover:translate-x-1"
