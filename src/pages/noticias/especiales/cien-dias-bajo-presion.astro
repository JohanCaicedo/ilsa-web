<script>
    // Handle footnote reference clicks - scroll to and open the accordion
    document.addEventListener('click', (e: MouseEvent) => {
        const target = e.target as HTMLElement | null;
        if (!target || !target.closest) return;
        
        const footnoteRef = target.closest('.footnote-ref');
        if (!footnoteRef) return;

        e.preventDefault();
        const href = footnoteRef.getAttribute('href');
        if (!href || !href.startsWith('#fn-')) return;

        const targetId = href.slice(1); // Remove #

        // Call the global function from SimpleAccordion if it exists
        const scrollFn = (window as unknown as { scrollToFootnote?: (id: string) => void }).scrollToFootnote;
        if (typeof scrollFn === 'function') {
            scrollFn(targetId);
        } else {
            // Fallback: just scroll to element
            const targetEl = document.getElementById(targetId);
            if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
        
        // Add highlight
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
            targetElement.classList.add('ring-2', 'ring-orange-500', 'rounded');
            setTimeout(() => targetElement.classList.remove('ring-2', 'ring-orange-500', 'rounded'), 2000);
        }
    });

    // Entrance animations for page elements
    function animatePageElements() {
      const elements = document.querySelectorAll('[data-animate]');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            let delay = 0;
            
            if (el.dataset.animate === 'stagger') {
              // Parent stagger container - animate children
              const children = el.querySelectorAll('[data-animate]');
              children.forEach((child, childIndex) => {
                const childDelay = childIndex * 80;
                setTimeout(() => child.classList.add('animate-in'), childDelay);
              });
            } else {
              // Individual element with optional CSS custom property delay
              const styleDelay = parseInt(el.style.getPropertyValue('--delay') || '0', 10);
              delay = styleDelay;
              setTimeout(() => el.classList.add('animate-in'), delay);
            }
            observer.unobserve(el);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      elements.forEach((el) => observer.observe(el));
    }

    // Ejecutar en carga y en transiciones de Astro
    document.addEventListener('astro:page-load', animatePageElements);
    document.addEventListener('DOMContentLoaded', animatePageElements);
</script>