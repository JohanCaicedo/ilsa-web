<!-- Client Script for Interactive Language Tabs -->
<script>
    const btnEs = document.getElementById("btn-lang-es");
    const btnFr = document.getElementById("btn-lang-fr");
    const contentEs = document.getElementById("content-es");
    const contentFr = document.getElementById("content-fr");

    if (btnEs && btnFr && contentEs && contentFr) {
        btnEs.addEventListener("click", () => {
            contentEs.classList.remove("hidden");
            contentFr.classList.add("hidden");

            btnEs.className =
                "px-6 py-2.5 rounded-full text-sm font-bold transition-all duration-300 shadow-md bg-[var(--ilsa-blue)] text-white";
            btnFr.className =
                "px-6 py-2.5 rounded-full text-sm font-bold text-slate-600 hover:text-slate-900 transition-all duration-300";
        });

        btnFr.addEventListener("click", () => {
            contentFr.classList.remove("hidden");
            contentEs.classList.add("hidden");

            btnFr.className =
                "px-6 py-2.5 rounded-full text-sm font-bold transition-all duration-300 shadow-md bg-[var(--ilsa-blue)] text-white";
            btnEs.className =
                "px-6 py-2.5 rounded-full text-sm font-bold text-slate-600 hover:text-slate-900 transition-all duration-300";
        });
    }

    const featuredBtn = document.getElementById("featured-img-btn");
    if (featuredBtn) {
        featuredBtn.addEventListener("click", () => {
            const highRes = featuredBtn.getAttribute("data-highres") || "";
            const alt = featuredBtn.getAttribute("data-alt") || "";

            const event = new CustomEvent("open-lightbox", {
                detail: {
                    images: [{ src: highRes, alt: alt }],
                    startIndex: 0,
                },
            });
            window.dispatchEvent(event);
        });
    }
</script>
