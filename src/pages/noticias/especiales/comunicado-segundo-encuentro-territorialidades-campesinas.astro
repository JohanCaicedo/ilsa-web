---
import Layout from "../../../layouts/Layout.astro";
import GradientText from "../../../components/atoms/GradientText.astro";
import ShareButtons from "../../../components/atoms/ShareButtons.astro";
import Button from "../../../components/Button.astro";
import SmartImage from "../../../components/atoms/SmartImage.astro";
import RelatedSlider from "../../../components/organisms/RelatedSlider.astro";
import { getPostsByCategory, type CardPostNode } from "../../../lib/wp";
import {
    FileText,
    Eye,
    Download,
    Newspaper,
    ArrowRight,
    Camera,
} from "lucide-react";
import type { SeoData } from "../../../lib/seo";

export const prerender = true;

const title =
    "COMUNICADO A LA OPINIÓN PÚBLICA, INTERNACIONAL, AUTORIDADES GUBERNAMENTALES, RAMA JUDICIAL Y A LOS SECTORES POPULARES DE COLOMBIA";
const slug = "comunicado-segundo-encuentro-territorialidades-campesinas";
const photoBaseUrl =
    "https://api.ilsa.org.co/wp-content/uploads/2026/09/Cominicado-II-Encuentro-de-territorialidades-campesinas.webp";
const pdfUrl =
    "https://api.ilsa.org.co/wp-content/uploads/2026/10/Comunicado-II-Encuentro-de-territorialidades-campesinas-Final.pdf";
const pressNoteUrl =
    "/noticias/especiales/segundo-encuentro-territorialidades-campesinas";
const pressNoteImage =
    "https://api.ilsa.org.co/wp-content/uploads/2026/09/Evento-II-segundo-encuentro-territorialidades-campesinas-20.webp";
const encounter =
    "II Encuentro de territorialidades campesinas de los departamentos de Boyacá, Santander, Tolima y Cundinamarca";

let opinionArticles: CardPostNode[] = [];
try {
    opinionArticles = await getPostsByCategory("opinion", 10);
} catch (error) {
    console.error("Error al cargar artículos de opinión:", error);
}

const comunicado = `Líderes y lideresas campesinos provenientes de las Zonas de Reserva Campesina (ZRC) de los municipios de Cabrera, Venecia, Páramo de Pisba, Samacá, Cómbita-Motavita y Togüí; de las Áreas de Protección para la Producción de Alimentos (APPA) de los municipios de Tenjo, Chía y Cajicá; y los Territorios Campesinos Agroalimentarios (TECAM): Cacique Poima (Oiba y Guadalupe), TECAM Alas del Territorio (Jesús María), TECAM Gran Cordillera de los Agataes (Vélez y Bolívar), y TECAM Moniquirá, convocados por el Instituto Latinoamericano para una Sociedad y un Derecho Alternativos (ILSA), reunidos los días 25 y 26 de septiembre del presente año, en la ciudad de Bogotá D.C., manifestamos:
1. Los campesinos y campesinas existimos en Colombia. Somos sujetos políticos, social y territorialmente organizados. La Constitución nos reconoce como sujetos y sujetas de derechos y de especial protección gracias al Acto Legislativo 01 de 2023, reformatorio del artículo 64 superior que reconoció nuestra dimensión social, política, económica, cultural y ambiental. 
2. Rechazamos todo intento del Gobierno de borrar al campesino y a la campesina del lenguaje institucional, de los debates sociales, políticos y jurídicos, bajo la idea de que es una acepción peyorativa, cuando lo que se busca realmente es eliminar los compromisos estatales con las políticas agrarias que realizan nuestros derechos. Esta búsqueda del Gobierno por hacer invisible al campesinado no es nueva y, por el contrario, ha sido utilizada históricamente como un medio para promover y adelantar procesos sociales de exclusión y criminalización contra los campesinos y campesinas de nuestros territorios. Saludamos el fallo de tutela del Juzgado 46 Laboral del Circuito de Bogotá que amparó los derechos a la dignidad, igualdad y reconocimiento de la identidad, y ordenó a Ministro de Agricultura, Indalecio Dangond, a ofrecer disculpas a los campesinos y campesinas del país.
3. Rechazamos la estrategia jurídica y política que promueven actores económicos poderosos del país para desmontar los avances logrados en las políticas públicas agrarias que protegen y realizan nuestros derechos constitucionales. Consideramos estas maniobras anticampesinas  como un intento más de contrarreforma agraria en el país, que actualmente está generando violencia y violaciones a los derechos humanos en nuestros territorios. 
4. Vemos con gran preocupación los 19 procesos judiciales que se tramitan en la jurisdicción contenciosa-administrativa contra las APPA, las Zonas de Reserva Campesina y los TECAM, cuyo objetivo es anular los actos administrativos de creación de estas territorialidades, así como otras resoluciones del Ministerio de Agricultura que durante el Gobierno anterior, otorgaron incentivos y apoyos a la economía campesina, étnica, familiar y popular.
5. Llamamos a los jueces y juezas de la República y a los Organismos de Control a la defensa del campesinado y del Estado Social de Derecho. Las territorialidades campesinas se encuentran  reconocidas por diversos instrumentos normativos (artículos 64 y 65 de la Constitución y Ley 160 de 1994, entre otros) y, lo que es más importante, han sido creadas y legitimadas por los mismos campesinos y campesinas en sus  territorios.  Las territorialidades campesinas reconocen nuestras apuestas políticas por ordenar y gobernar nuestros territorios, por lo mismo, de adoptarse decisiones que deroguen o congelen los trámites de reconocimiento, de formalización legal y de implementación de las mismas, no podrá entenderse más que como un intento del Estado colombiano  para  desestabilizar nuestras organizaciones y procesos sociales.
6. Las organizaciones campesinas defendemos las APPA y los avances alcanzados en la protección de los suelos rurales para la producción de alimentos, frente a los retrocesos que pretenden desconocer su importancia para la seguridad alimentaria, el ordenamiento territorial y la subsistencia de la economía campesina. Llamamos a las organizaciones sociales y políticas a defender estas territorialidades, que garantizan la producción de nuestros alimentos y el futuro de las nuevas generaciones, y a rechazar que los intereses del volteo de tierras, la expansión urbana o la minería se impongan sobre el derecho de los pueblos a una alimentación digna y a decidir sobre sus territorios.
7. Advertimos con profunda preocupación la intención de materializar una política de un “campo sin campesinos”. Denunciamos que se busca acabar con la identidad y ancestralidad campesina al intentar categorizarnos simplemente como “pequeños empresarios del campo”. Esta visión, propia de un colonialismo excluyente, representa una amenaza de genocidio sociocultural del campesinado.
8. Alertamos al país de que actualmente cursa una acción popular en el Tribunal Administrativo de Cundinamarca que pretende derogar todas las figuras de las territorialidades campesinas. Hacemos un llamado a las organizaciones sociales y agrarias a defender estas figuras, y a participar en los escenarios judiciales donde se decide sobre ellas. Exigimos al Estado la protección de nuestros derechos políticos, sociales y colectivos, que son de especial protección constitucional. Nuestros derechos no son una concesión, sino una ganancia histórica de los movimientos campesinos. Como campesinado organizado, haremos uso de todos los mecanismos de lucha: la movilización social, la presión política y  las herramientas constitucionales y legales que estén a nuestro alcance para defender la dignidad del campesinado. 
9. Reivindicamos nuestro rol fundamental como guardianes ambientales. Ante la grave crisis climática y los incendios que hoy consumen a Santander, Tolima, Boyacá y a el resto del país, somos los campesinos y campesinas quienes hemos asumido  de manera responsable la protección de los bienes comunes: el agua, el suelo, los bosques y la biodiversidad, garantizando así la supervivencia de las futuras generaciones, ante la morosidad y falta de diligencia de las autoridades. 
10. Nuestro modelo de agricultura campesina y producción familiar no sólo ha resistido por más de 200 años, sino que hoy se erige como la verdadera solución estructural frente a la crisis climática: somos el campesinado quienes enfriamos el planeta. A través de la agroecología campesina, construimos una propuesta que garantiza la soberanía alimentaria sin agotar los bienes naturales, sustentado en nuestro profundo sentido de permanencia, dignidad y arraigo en el territorio. A diferencia del modelo agroindustrial y del monocultivo que devasta los suelos, el agua y los ecosistemas. Por ello, exigimos tierra y derechos para quienes garantizamos la vida cuidando a la naturaleza. 
11. Las ZRC y los TECAM representan para nuestros territorios una apuesta colectiva de gobernanza, cuidado comunitario del territorio y ordenamiento territorial que no fue una concesión del Estado, sino el resultado de décadas de lucha del campesinado por el reconocimiento de su papel como sujeto de derechos, y actor fundamental en la construcción de paz territorial. Desconocer o debilitar estas territorialidades, hoy no es un simple ajuste normativo: es un retroceso frente a compromisos que el Estado colombiano asumió con sus propias comunidades rurales y con el país entero en el marco de la construcción de paz.
12. Reafirmamos que nuestras territorialidades campesinas: ZRC, TECAM y Áreas de Protección para la Producción de Alimentos, son pilares indispensables para la soberanía alimentaria de la nación y la contención de la crisis climática, constituyéndose en territorios vivos donde la producción de alimentos coexiste de manera armónica con la protección del agua, los bosques y la biodiversidad. Frente a esta amenaza, no vamos a permitir que se desmonten silenciosamente los espacios de vida, organización y autonomía que hemos construido con esfuerzo propio. 
13. Rechazamos la estigmatización del Ministro de Agricultura, quien afirma que nuestras ZRC son tierras donde únicamente se cultiva coca. Este discurso no es gratuito: busca criminalizarnos como organizaciones sociales, y legitimar de paso decisiones políticas para intervenir nuestros territorios, ricos en recursos naturales. Nuestras territorialidades son territorios de paz y no permitiremos que se nos señale ante el país como un eslabón más del narcotráfico. Rechazamos igualmente la medida de hacer fumigación de cultivos de coca con glufosinato y con cualquier otro veneno químico, que contamine los suelos, las aguas y la salud de las comunidades en los territorios.
Por lo anterior, como territorialidades campesinas exigimos:
•  Facilitar y destrabar el proceso de formalización y consolidación de los TECAM y de las Zonas de Reserva Campesina, superando los cuellos de botella institucionales que hoy frenan iniciativas territoriales como las de Moniquirá, Alas del Territorio, la Gran Cordillera de los Agataes y Cacique Poima, además de otras territorialidades en el país.
• Garantizar el reconocimiento jurídico pleno de las figuras de TECAM y ZRC, con la asignación de recursos reales y efectivos para su constitución y funcionamiento. Exigimos la implementación inmediata del trazador presupuestal campesino.
• Lograr una articulación institucional vinculante que garantice el financiamiento de nuestros Planes de Vida Digna y Planes de Desarrollo Sostenible, así como la implementación real y con presupuesto estable y progresivo. 
• Garantizar mecanismos reforzados de participación y el reconocimiento vinculante de las ZRC y los TECAM en todos los temas que tengan que ver con nuestros territorios, instando en ello al Congreso de la República, al Gobierno Nacional y a las entidades territoriales e instituciones competentes.
• Reconocer y respetar todas las dimensiones de la vida, cultura, ancestralidad e identidad del campesinado en las políticas públicas, así como su papel de guardián ambiental de los territorios, formal y materialmente.
• Aprobar e implementar el proyecto de Ley de Agroecología que permita avanzar hacia la transición agroecológica y la soberanía alimentaria como pilares de la política campesina. También exigimos la expedición de la ley que reglamenta el funcionamiento de la Jurisdicción Agraria.
• Implementar una educación con enfoque diferencial campesino, verdaderamente contextualizada a las realidades, necesidades y saberes de nuestros territorios.
• Fortalecer la cadena de producción, transformación y comercialización de mercados justos, con apoyos técnicos para el fortalecimiento productivo agroecológico, titulación masiva de tierras y acceso a bienes públicos que aseguren la permanencia digna en el campo.
• Garantizar el acceso al trazador presupuestal y fomentar los presupuestos participativos con las comunidades.
• Promover la armonización y el rescate de nuestros saberes ancestrales, facilitando un diálogo horizontal entre la ciencia médica y la medicina tradicional campesina.
• Brindar garantías reales para la constitución y consolidación de nuestras territorialidades, evitando los obstáculos disfrazados de tecnicismos administrativos o de intereses económicos ajenos al territorio.
Instamos a la sociedad civil a defender a las territorialidades campesinas y a solidarizarse con el conjunto del movimiento campesino. Debemos estar unidos y alerta frente a un nuevo escenario legal y violento de contrarreforma agraria: es un momento para construir lazos de unidad y fortalecer en nuestros territorios una apuesta por la defensa de la vida.
Hacemos un llamado a la organización, unidad y movilización de los sectores agrarios y populares; a los pueblos indígenas, pueblos negros, raizales, palenqueros y a las comunidades pesqueras y anfibias, para que nos encontremos nuevamente alrededor de la necesidad de crear un movimiento agrario unificado y en pie de lucha. 
Consideramos necesario que nos encontremos Zonas de Reserva Campesina, Territorios Campesinos Agroalimentarios, Áreas de Protección para la Producción de Alimentos y Territorios Acuáticos Agroalimentarios en un ENCUENTRO NACIONAL DE TERRITORIALIDADES CAMPESINAS para construir una apuesta conjunta por la defensa de nuestras territorialidades y derechos.
`;
const encounterPhrase = "ENCUENTRO NACIONAL DE TERRITORIALIDADES CAMPESINAS";
const slogans = [
    "¡Por una reforma agraria estructural, integral y popular!",
    "¡Por la Tierra, el Territorio y la Soberanía Alimentaria!",
    "¡Reforma Agraria Integral y Popular ya!",
];
const signatories = `• TERRITORIO CAMPESINO AGROALIMENTARIO MONIQUIRÁ
• ZONA DE RESERVA CAMPESINA PARAISO ESCONDIDO: TOGÜÍ
• ZONA DE RESERVA CAMPESINA VENECIA PARTE ALTA
• ASOCIACIÓN DE GESTIÓN, UNIDAD Y ACCIÓN CAMPESINA
• AGUA CAMPESINA
• ZONA DE RESERVA CAMPESINA DE CABRERA-ASOCIACIÓN CAMPESINA CUNA DE PAZ CORCUNPAZ
• ZONA DE RESERVA CAMPESINA SANTUARIO DEL RÁBANAL SAMACÁ Y VENTAQUEMADA
• ASOCIACIÓN DE PEQUEÑOS Y MEDIANOS AGRICULTUROES DE BOYACÁ-MOTAVITA-COMBITA-ARCABUCO
• ASOAGRYNBOY-FENSUAGRO
• ANUC CAJICÁ
• ANUC BOYACÁ
• ANUC CUNDINAMARCA
• ANUC CHÍA
• ANUC TENJO
• COMITÉ DE IMPULSO DE ZRC DEL PÁRAMO DE PISBA
• AZOACTASCO
• VEEDURIA AMBIENTAL DE TASCO
• VELEZ 500 AÑOS UNIDOS POR EL DESARROLLO
• CONGRESO AMBIENTAL DE SANTANDER-CASA AGUAYA
• TECAM CACIQUE POIMA 
• TECAM ALAS DEL TERRITORIO 
• TECAM GRAN CORDILLERA DE LOS AGATAES
• GRUPO DE INVESTIGACIÓN EN ESTUDIOS AGRARIOS Y CAMPESINOS SUMAPAZ
• INSTITUTO LATINOAMERICANO PARA UNA SOCIEDAD Y UN DERECHO ALTERNATIVOS (ILSA)
• RED COLOMBIANA DE ABOGACÍA POPULAR
• ZONA DE RESERVA CAMPESINA DE SUMAPAZ
• CORDINADORA CAMPESINA CRUZ VERDE SUMAPAZ`.split("\n");

const seoData: SeoData = {
    title: "Comunicado sobre territorialidades campesinas | ILSA",
    metaDesc:
        "Comunicado del II Encuentro de Territorialidades Campesinas sobre la defensa de las ZRC, los TECAM y las APPA.",
    canonical: `https://ilsa.org.co/noticias/especiales/${slug}`,
    opengraphTitle:
        "Comunicado II Encuentro de territorialidades campesinas de los departamentos de Boyacá, Santander, Tolima y Cundinamarca",
    opengraphDescription:
        "Comunicado del II Encuentro de Territorialidades Campesinas sobre la defensa de las ZRC, los TECAM y las APPA.",
    opengraphImage: { sourceUrl: photoBaseUrl },
    twitterTitle:
        "Comunicado II Encuentro de territorialidades campesinas de los departamentos de Boyacá, Santander, Tolima y Cundinamarca",
    twitterImage: { sourceUrl: photoBaseUrl },
};

const breadcrumbs = [
    { label: "Noticias", href: "/noticias" },
    { label: "Especiales", href: "/noticias" },
    {
        label: "Comunicado territorialidades campesinas",
        href: `/noticias/especiales/${slug}`,
    },
];
---

<Layout
    title={seoData.title}
    width="wide"
    seo={seoData}
    breadcrumbs={breadcrumbs}
>
    <div class="relative min-h-screen pb-32">
        <div class="absolute inset-0 pointer-events-none overflow-hidden">
            <div
                class="absolute top-1/6 left-1/4 h-[500px] w-[500px] rounded-full bg-[var(--ilsa-blue-light)]/15 blur-[120px] animate-blob"
            >
            </div>
            <div
                class="absolute right-1/4 top-1/2 h-[450px] w-[450px] rounded-full bg-[var(--ilsa-blue-dark)]/10 blur-[110px] animate-blob animation-delay-2000"
            >
            </div>
        </div>

        <main class="relative z-10 mx-auto max-w-5xl px-4 pt-8 md:px-8">
            <article
                class="rounded-[2rem] border border-white/60 bg-white/50 p-6 shadow-2xl shadow-slate-200/50 backdrop-blur-3xl md:rounded-[3rem] md:p-12"
            >
                <header class="mx-auto max-w-4xl space-y-5 pb-10 text-center">
                    <p
                        class="text-lg font-light italic leading-relaxed text-[#5d4a44] md:text-xl"
                    >
                        {encounter}
                    </p>
                    <p class="text-base font-medium text-[#5d4a44]">
                        Bogotá D.C. 26 de septiembre de 2026
                    </p>
                    <GradientText
                        text={title}
                        as="h1"
                        size="text-[1.5rem] md:text-[2.4rem]"
                        weight="font-black"
                        from="#5d4a44"
                        to="#5d4a44"
                        class="mx-auto w-full text-center leading-[1.12] text-balance drop-shadow-sm"
                    />
                </header>

                <div
                    class="mx-auto max-w-3xl space-y-4 text-pretty text-lg font-light leading-relaxed text-[#5d4a44]"
                >
                    {
                        comunicado
                            .trim()
                            .split("\n")
                            .filter(Boolean)
                            .map((line, index) => {
                                const numbered =
                                    line.match(/^\s*(\d+)\.\s*(.*)$/);
                                const phraseIndex =
                                    line.indexOf(encounterPhrase);

                                if (index === 0) {
                                    return (
                                        <p class="px-1 pb-3 text-base font-medium leading-relaxed md:pb-4 md:text-lg">
                                            {line}
                                        </p>
                                    );
                                }

                                if (numbered) {
                                    return (
                                        <div class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-3 rounded-2xl border border-[#5d4a44]/10 bg-white/45 p-4 shadow-sm md:grid-cols-[3rem_minmax(0,1fr)] md:gap-4 md:p-5">
                                            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#5d4a44]/10 text-sm font-bold text-[#5d4a44] md:h-10 md:w-10">
                                                {numbered[1]}
                                            </span>
                                            <p class="self-center">
                                                {numbered[2]}
                                            </p>
                                        </div>
                                    );
                                }

                                if (line.startsWith("•")) {
                                    return (
                                        <div class="grid grid-cols-[1rem_minmax(0,1fr)] gap-3 px-2 md:gap-4">
                                            <span class="mt-2 h-2 w-2 rounded-full bg-[#5d4a44]/65" />
                                            <p>{line.slice(1).trim()}</p>
                                        </div>
                                    );
                                }

                                if (
                                    line ===
                                    "Por lo anterior, como territorialidades campesinas exigimos:"
                                ) {
                                    return (
                                        <h2 class="pt-4 text-base font-black uppercase tracking-[0.12em] text-[#5d4a44] md:pt-6">
                                            {line}
                                        </h2>
                                    );
                                }

                                if (phraseIndex >= 0) {
                                    return (
                                        <p>
                                            {line.slice(0, phraseIndex)}
                                            <strong class="font-bold">
                                                {encounterPhrase}
                                            </strong>
                                            {line.slice(
                                                phraseIndex +
                                                    encounterPhrase.length,
                                            )}
                                        </p>
                                    );
                                }

                                return <p>{line}</p>;
                            })
                    }
                    <div
                        class="mt-8 space-y-3 rounded-2xl border border-[#5d4a44]/15 border-l-4 border-l-[#5d4a44] bg-white/70 px-6 py-6 text-center shadow-lg shadow-slate-200/40 md:px-10 md:py-8"
                    >
                        {
                            slogans.map((slogan, index) => (
                                <p
                                    class:list={[
                                        "font-semibold text-[#5d4a44]",
                                        index === 1
                                            ? "text-lg md:text-xl"
                                            : "text-base md:text-lg",
                                        index === 2 &&
                                            "font-black uppercase tracking-wide",
                                    ]}
                                >
                                    {slogan}
                                </p>
                            ))
                        }
                    </div>
                </div>

                <section
                    class="mx-auto mt-12 max-w-3xl border-t border-[#5d4a44]/20 pt-10"
                >
                    <h2
                        class="mb-6 text-center text-xl font-black tracking-wide text-[#5d4a44]"
                    >
                        SUSCRIBEN
                    </h2>
                    <ul
                        class="grid gap-x-8 gap-y-3 text-sm font-medium leading-relaxed text-[#5d4a44] md:grid-cols-2"
                    >
                        {
                            signatories.map((signatory) => (
                                <li class="min-w-0 break-words border-l-2 border-[#5d4a44]/30 pl-3">
                                    {signatory.replace(/^•\s*/, "")}
                                </li>
                            ))
                        }
                    </ul>
                </section>

                {/* ─── VISOR DE PDF DEL COMUNICADO OFICIAL ─── */}
                <section
                    class="mx-auto mt-14 max-w-3xl space-y-6 border-t border-[#5d4a44]/20 pt-12"
                    aria-label="Documento PDF del Comunicado Oficial"
                >
                    <div class="text-center">
                        <div
                            class="inline-flex items-center gap-2 rounded-full border border-[#5d4a44]/20 bg-[#5d4a44]/10 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-[#5d4a44]"
                        >
                            <FileText className="h-3.5 w-3.5" /> Documento Oficial en PDF
                        </div>
                    </div>

                    <div
                        class="pdf-pill mx-auto max-w-3xl"
                        data-pdf-url={pdfUrl}
                    >
                        <span class="pdf-icon">
                            <FileText className="h-6 w-6" />
                        </span>
                        <div class="flex-1 min-w-[200px] text-left">
                            <p class="text-sm font-bold text-[#5d4a44] truncate">
                                Comunicado-II-Encuentro-de-territorialidades-campesinas-Final.pdf
                            </p>
                            <p class="text-xs text-[#5d4a44]/70">
                                Documento original suscrito · PDF
                            </p>
                        </div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <button
                                type="button"
                                class="btn-pdf btn-pdf-view"
                                aria-expanded="false"
                            >
                                <Eye className="h-4 w-4" /> Ver PDF
                            </button>
                            <a
                                href={`/api/download?url=${encodeURIComponent(pdfUrl)}`}
                                download="Comunicado-II-Encuentro-de-territorialidades-campesinas-Final.pdf"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn-pdf btn-pdf-download"
                            >
                                <Download className="h-4 w-4" /> Descargar
                            </a>
                        </div>
                    </div>

                    <div
                        class="pdf-viewer-shell pdf-viewer-letter mx-auto max-w-3xl"
                        aria-live="polite"
                    >
                    </div>
                </section>

                {/* ─── TARJETA / BOTÓN HACIA LA NOTA DE PRENSA ─── */}
                <section
                    class="mx-auto mt-12 max-w-3xl border-t border-[#5d4a44]/20 pt-10"
                    aria-label="Nota de prensa relacionada"
                >
                    <div
                        class="group relative overflow-hidden rounded-3xl border border-white/70 bg-gradient-to-br from-white/80 via-white/60 to-white/40 p-6 shadow-xl shadow-slate-200/50 backdrop-blur-xl transition-all duration-300 hover:border-white/90 hover:shadow-2xl md:p-8"
                    >
                        <div
                            class="grid grid-cols-1 gap-6 md:grid-cols-[200px_1fr] md:items-center"
                        >
                            <div
                                class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-slate-100 shadow-inner md:aspect-square"
                            >
                                <SmartImage
                                    src={pressNoteImage}
                                    alt="II Encuentro de territorialidades campesinas - Galería y nota de prensa"
                                    width={400}
                                    height={400}
                                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                                />
                                <span
                                    class="absolute bottom-2 left-2 inline-flex items-center gap-1 rounded-full bg-black/60 px-2.5 py-1 text-[11px] font-semibold text-white backdrop-blur-md"
                                >
                                    <Camera className="h-3 w-3" /> 45 fotos
                                </span>
                            </div>

                            <div class="space-y-3">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span
                                        class="inline-flex items-center gap-1.5 rounded-full border border-[var(--ilsa-blue)]/20 bg-[var(--ilsa-blue)]/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--ilsa-blue-dark)]"
                                    >
                                        <Newspaper className="h-3.5 w-3.5" /> Nota de prensa
                                    </span>
                                    <span class="text-xs font-medium text-slate-500">
                                        25 y 26 de septiembre de 2026
                                    </span>
                                </div>

                                <h3
                                    class="text-lg font-bold leading-snug text-slate-800 md:text-xl"
                                >
                                    II Encuentro de territorialidades campesinas: Boyacá, Santander, Tolima y Cundinamarca
                                </h3>

                                <p
                                    class="text-sm font-light leading-relaxed text-slate-600"
                                >
                                    Lee la crónica de la jornada, los acuerdos alcanzados frente a las acciones judiciales y recorre la galería fotográfica completa del evento.
                                </p>

                                <div class="pt-2">
                                    <Button
                                        href={pressNoteUrl}
                                        variant="primary"
                                        size="md"
                                        class="inline-flex items-center gap-2 shadow-md transition-all hover:gap-3 hover:shadow-lg"
                                    >
                                        <span>Ir a la nota de prensa</span>
                                        <ArrowRight className="h-4 w-4" />
                                    </Button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                {/* ─── ARTÍCULOS DE OPINIÓN RELACIONADOS (SLIDER) ─── */}
                {
                    opinionArticles && opinionArticles.length > 0 && (
                        <div class="border-t border-[#5d4a44]/20 pt-6">
                            <RelatedSlider posts={opinionArticles} />
                        </div>
                    )
                }

                <footer
                    class="mx-auto mt-12 max-w-2xl space-y-6 border-t border-slate-200/70 pt-8 text-center"
                >
                    <div class="flex justify-center">
                        <ShareButtons
                            url={`https://ilsa.org.co/noticias/especiales/${slug}`}
                            title={title}
                        />
                    </div>
                    <div class="flex items-center justify-center gap-3">
                        <div class="h-px w-8 bg-slate-200"></div><span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-[var(--ilsa-blue-dark)]"
                            >ILSA · TERRITORIALIDADES CAMPESINAS</span
                        ><div class="h-px w-8 bg-slate-200"></div>
                    </div>
                </footer>
            </article>
        </main>
    </div>
</Layout>

<style>
    .pdf-pill {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 24px;
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 999px;
        box-shadow: 0 8px 32px 0 var(--glass-shadow, rgba(31, 38, 135, 0.08));
        flex-wrap: wrap;
    }

    .pdf-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(93, 74, 68, 0.08);
        color: #5d4a44;
        flex-shrink: 0;
    }

    .btn-pdf {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 20px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: all 0.25s ease;
        white-space: nowrap;
        text-decoration: none;
    }

    .btn-pdf-view {
        border: none;
        background: #5d4a44;
        color: white;
        box-shadow: 0 4px 12px rgba(93, 74, 68, 0.25);
    }
    .btn-pdf-view:hover {
        background: #463732;
        box-shadow: 0 6px 18px rgba(93, 74, 68, 0.35);
        transform: translateY(-1px);
    }
    .btn-pdf-download {
        border: 1.5px solid #5d4a44;
        background: transparent;
        color: #5d4a44;
    }
    .btn-pdf-download:hover {
        background: rgba(93, 74, 68, 0.08);
        transform: translateY(-1px);
    }

    .pdf-viewer-shell {
        width: 100%;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 16px 48px -8px var(--glass-shadow, rgba(31, 38, 135, 0.12));
        border: 1px solid rgba(255, 255, 255, 0.6);
        background: #f8fafc;
        margin-top: 16px;
        max-height: 0;
        transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .pdf-viewer-letter.open {
        max-height: 1000px;
    }
    .pdf-viewer-letter :global(iframe) {
        display: block;
        width: 100%;
        height: 1000px;
        border: none;
    }

    @media (max-width: 640px) {
        .pdf-pill {
            border-radius: 20px;
            flex-direction: column;
            align-items: stretch;
            padding: 16px;
        }
        .btn-pdf {
            justify-content: center;
            width: 100%;
        }
        .pdf-viewer-letter.open {
            max-height: 600px;
        }
        .pdf-viewer-letter :global(iframe) {
            height: 600px;
        }
    }
</style>

<script>
    function setupPdfViewer() {
        document
            .querySelectorAll<HTMLElement>(".pdf-pill[data-pdf-url]")
            .forEach((pill) => {
                if (pill.dataset.bound === "true") return;
                pill.dataset.bound = "true";

                const pdfUrl = pill.dataset.pdfUrl;
                const viewButton =
                    pill.querySelector<HTMLButtonElement>(".btn-pdf-view");
                const viewer = pill.nextElementSibling as HTMLElement | null;

                if (
                    !pdfUrl ||
                    !viewButton ||
                    !viewer?.classList.contains("pdf-viewer-shell")
                )
                    return;

                viewButton.addEventListener("click", () => {
                    if (window.innerWidth < 768) {
                        window.open(pdfUrl, "_blank");
                        return;
                    }

                    const isOpen = viewer.classList.contains("open");
                    if (!isOpen && !viewer.querySelector("iframe")) {
                        const iframe = document.createElement("iframe");
                        iframe.src = `${pdfUrl}#toolbar=1&navpanes=0`;
                        iframe.title = "Visor Documento Comunicado Oficial PDF";
                        iframe.loading = "lazy";
                        viewer.appendChild(iframe);
                    }

                    viewer.classList.toggle("open", !isOpen);
                    viewButton.setAttribute("aria-expanded", String(!isOpen));
                    viewButton.innerHTML = isOpen
                        ? `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:16px;height:16px"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.399 8.049 7.21 5 12 5c4.791 0 8.601 3.049 9.964 6.322.059.136.059.308 0 .444C20.601 15.951 16.79 19 12 19c-4.791 0-8.601-3.049-9.964-6.322z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg> Ver PDF`
                        : `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:16px;height:16px"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg> Ocultar`;
                });
            });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupPdfViewer, {
            once: true,
        });
    } else {
        setupPdfViewer();
    }

    document.addEventListener("astro:page-load", setupPdfViewer);
</script>
