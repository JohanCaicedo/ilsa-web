---
import Layout from "../../layouts/Layout.astro";
import AccordionItem from "../../components/atoms/AccordionItem.astro";
import DirectorCard from "../../components/molecules/DirectorCard.astro";
import TeamModal from "../../components/molecules/TeamModal.astro";
import WorkTeamTabs from "../../components/molecules/WorkTeamTabs.astro";
import ColombiaMap from "../../components/organisms/ColombiaMap.astro";
import Breadcrumbs from "../../components/atoms/Breadcrumbs.astro";
import Button from "../../components/Button.astro";
import GradientText from "../../components/atoms/GradientText.astro";
import SmartImage from "../../components/atoms/SmartImage.astro";
import AutoSlider from "../../components/templates/AutoSlider.astro";
import HistoryTimeline from "../../components/organisms/HistoryTimeline.astro";
import { wpQuery } from "../../lib/wp";
import { teamData, boardData, assemblyData } from "../../lib/team";
import type { SeoData } from "../../lib/seo";

const heroImages = [
    "/images/gallery/Nosotros (5).webp",
    "/images/gallery/Nosotros (6).webp",
    "/images/gallery/Nosotros (7).webp",
    "/images/gallery/Nosotros (12).webp",
    "/images/gallery/Nosotros (14).webp",
];

const geoImages = [
    "/images/gallery/HomeGalery (1).webp",
    "/images/gallery/Nosotros (1).webp",
    "/images/gallery/Nosotros (8).webp",
    "/images/gallery/Nosotros (15).webp",
];

const missionImages = [
    "/images/gallery/HomeGalery (2).webp",
    "/images/gallery/Nosotros (2).webp",
    "/images/gallery/Nosotros (9).webp",
    "/images/gallery/HomeGalery (6).webp",
];

const visionImages = [
    "/images/gallery/HomeGalery (3).webp",
    "/images/gallery/Nosotros (3).webp",
    "/images/gallery/Nosotros (10).webp",
    "/images/gallery/Nosotros (13).webp",
];

const camposImages = [
    "/images/gallery/HomeGalery (4).webp",
    "/images/gallery/HomeGalery (5).webp",
    "/images/gallery/Nosotros (4).webp",
    "/images/gallery/Nosotros (11).webp",
];

export const prerender = true;

// Edge Caching (ISR): Serve from Edge cache for 1 hr, revalidate in background for 1 day
// Content is static (team data from lib/team.ts), only SEO metadata comes from WordPress
Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=3600, stale-while-revalidate=86400",
);

const breadcrumbItems = [{ label: "Nosotros", href: "/nosotros" }];

// Fetch SEO Data specifically for this page (graceful degradation if WP unavailable)
let seoData: SeoData | undefined;
try {
    const data = await wpQuery({
        query: `
        query GetNosotrosSEO {
          page(id: "/nosotros", idType: URI) {
            seo {
              title
              metaDesc
              canonical
              opengraphTitle
              opengraphDescription
              opengraphImage {
                sourceUrl
              }
              twitterTitle
              twitterDescription
              twitterImage {
                 sourceUrl
              }
            }
          }
        }
      `,
    });
    seoData = data?.page?.seo;
} catch (error) {
    // Graceful degradation: page works without SEO data from WordPress
    console.error("[nosotros] Failed to fetch SEO data from WordPress:", error);
    seoData = undefined;
}
---

<Layout seo={seoData} breadcrumbs={breadcrumbItems}>
    <div
        class="relative min-h-screen text-[#3d3d47] overflow-hidden overflow-x-hidden font-sans"
    >
        <!-- Global Atmosphere Gradients (Cool & Clean) -->
        <div class="fixed top-0 left-0 w-full h-full pointer-events-none z-0">
            <!-- Enhanced Blue/Coolness -->
            <div
                class="absolute top-[-20%] right-[-10%] w-[50%] h-[50%] bg-[#4e7cce]/5 rounded-full blur-[120px]"
            >
            </div>
            <div
                class="absolute bottom-[-10%] left-[-10%] w-[50%] h-[50%] bg-[#4e7cce]/5 rounded-full blur-[120px]"
            >
            </div>
        </div>

        <div class="relative z-10 pt-8 pb-24 px-6 md:px-12 max-w-7xl mx-auto">
            <!-- HERO SECTION -->
            <section
                id="historia"
                class="mb-24 flex flex-col items-center text-center max-w-5xl mx-auto scroll-mt-32"
            >
                <!-- Badge -->
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-[#4e7cce]/20 shadow-sm mb-8"
                >
                    <span class="relative flex h-3 w-3">
                        <span
                            class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-[#4e7cce] opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-3 w-3 bg-[#4e7cce]"
                        ></span>
                    </span>
                    <span
                        class="text-xs md:text-sm font-bold text-[#4e7cce] uppercase tracking-widest"
                    >
                        Fundado en 1978
                    </span>
                </div>

                <!-- Headline -->
                <h1
                    class="text-5xl md:text-6xl lg:text-7xl font-bold text-center text-[#3d3d47] mb-8 tracking-tight leading-[1.1] text-balance"
                >
                    Justicia Social y <br class="hidden md:block" />
                    <span class="text-[#4e7cce]">Derecho Alternativo</span>
                </h1>

                <!-- Lead -->
                <p
                    class="text-md md:text-lg text-[#3d3d47]/80 max-w-3xl mx-auto leading-relaxed mb-12 text-pretty"
                >
                    Organización no gubernamental creada bajo la convicción de
                    que el derecho puede y debe ser una herramienta para
                    impulsar transformaciones sociales y afianzar la justicia en
                    América Latina y el Caribe.
                </p>

                <!-- Hero Image -->
                <AutoSlider
                    class="mb-16"
                    slides={heroImages}
                    alt="Territorio y Naturaleza"
                />

                <!-- Feature Grid -->
                <div class="grid md:grid-cols-3 gap-8 w-full text-left">
                    <div
                        class="p-8 rounded-2xl bg-white border border-slate-100 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:shadow-[#4e7cce]/10 transition-all duration-300 group"
                    >
                        <div
                            class="w-12 h-12 rounded-lg bg-blue-50 text-[#4e7cce] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                        </div>
                        <h3 class="text-xl font-bold text-[#3d3d47] mb-3">
                            Trayectoria Regional
                        </h3>
                        <p class="text-[#3d3d47]/70 text-sm leading-relaxed">
                            Con domicilio principal en Bogotá y un profundo
                            arraigo en América Latina y el Caribe, consolidamos
                            una experiencia histórica en investigación
                            sociopolítica.
                        </p>
                    </div>

                    <div
                        class="p-8 rounded-2xl bg-white border border-slate-100 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:shadow-[#5e3b69]/10 transition-all duration-300 group"
                    >
                        <div
                            class="w-12 h-12 rounded-lg bg-purple-50 text-[#5e3b69] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                                ></path></svg
                            >
                        </div>
                        <h3 class="text-xl font-bold text-[#3d3d47] mb-3">
                            Servicio Jurídico Crítico
                        </h3>
                        <p class="text-[#3d3d47]/70 text-sm leading-relaxed">
                            Desplegamos una praxis emancipatoria mediante
                            labores pedagógicas y el acompañamiento organizativo
                            a sectores populares.
                        </p>
                    </div>

                    <div
                        class="p-8 rounded-2xl bg-white border border-slate-100 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:shadow-[#e9b384]/20 transition-all duration-300 group"
                    >
                        <div
                            class="w-12 h-12 rounded-lg bg-orange-50 text-[#e9b384] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                                ></path></svg
                            >
                        </div>
                        <h3 class="text-xl font-bold text-[#3d3d47] mb-3">
                            Ecología de Saberes
                        </h3>
                        <p class="text-[#3d3d47]/70 text-sm leading-relaxed">
                            Articulamos las ciencias sociales y diversas áreas
                            del saber para abordar de manera inter, multi y
                            transdisciplinar los fenómenos sociales complejos.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Divider -->
            <div
                class="w-full h-px bg-gradient-to-r from-transparent via-[#3d3d47]/10 to-transparent mb-24"
            >
            </div>

            <!-- HISTORIA INSTITUCIONAL - Scroll Timeline -->
            <HistoryTimeline />

            <!-- GEO PRESENCE -->
            <section class="max-w-7xl mx-auto mb-24 text-center">
                <h2 class="text-3xl font-bold text-[#3d3d47] mb-8 text-center">
                    Presencia Geográfica
                </h2>

                <div class="flex flex-col items-center gap-8">
                    <!-- Mapa + texto (centrado, 2/3 del ancho) -->
                    <div class="w-full md:w-2/3 flex flex-col gap-4">
                        <ColombiaMap />
                        <p
                            class="text-[#3d3d47]/70 italic text-sm leading-relaxed"
                        >
                            Despliegue de trabajo situado y adaptado
                            culturalmente en el Ariari (Meta), Costa Pacífica
                            (Cauca), Páramo de Pisba (Boyacá), Urabá
                            (Antioquia), Provincia de Vélez (Santander), Laguna
                            de La Cocha (Nariño), Trapecio Amazónico, Montes de
                            María y el Archipiélago.
                        </p>
                    </div>

                    <!-- Carrusel debajo, ancho completo -->
                    <AutoSlider
                        class="h-[280px] md:h-[350px] rounded-3xl shadow-lg border border-white/50"
                        slides={geoImages}
                        alt="Ubicación Geográfica ILSA"
                    />
                </div>
            </section>

            <!-- MISSION / VISION -->
            <section class="grid md:grid-cols-2 gap-12 mb-32 items-center">
                <!-- Mission Content -->
                <div class="order-2 md:order-1">
                    <div class="inline-flex items-center gap-2 mb-4">
                        <span class="w-2 h-8 bg-[#4e7cce] rounded-full"></span>
                        <h2
                            class="text-4xl font-bold text-[#3d3d47]"
                            id="mision"
                        >
                            Misión
                        </h2>
                    </div>
                    <p
                        class="text-lg text-[#3d3d47] leading-relaxed mb-6 font-medium"
                    >
                        Promover una práctica crítica del derecho desde el
                        horizonte de los servicios legales alternativos.
                    </p>
                    <div
                        class="space-y-4 text-[#3d3d47]/80 leading-relaxed text-pretty"
                    >
                        <p>
                            ILSA se constituye como un centro de
                            investigación-acción orientado a consolidar una
                            concepción integral de los derechos humanos.
                            Buscamos romper con las lógicas tradicionales de la
                            práctica jurídica, articulando el pensamiento
                            crítico con la acción sociopolítica de los sectores
                            populares.
                        </p>
                        <p>
                            A través del servicio jurídico crítico y la
                            educación jurídica popular, contribuimos en la
                            construcción de procesos de exigibilidad para
                            asociaciones campesinas, pueblos indígenas,
                            comunidades afro, procesos de mujeres y población
                            firmante de paz.
                        </p>
                    </div>
                </div>

                <!-- Mission Image -->
                <AutoSlider
                    class="order-1 md:order-2 h-[450px] rounded-[2.5rem] shadow-xl shadow-blue-900/10"
                    slides={missionImages}
                    alt="Trabajo comunitario de ILSA con movimientos sociales"
                />

                <!-- Vision Image -->
                <AutoSlider
                    class="h-[450px] rounded-[2.5rem] shadow-xl shadow-purple-900/10"
                    slides={visionImages}
                    alt="Territorios y comunidades que defiende ILSA"
                />

                <!-- Vision Content -->
                <div>
                    <div class="inline-flex items-center gap-2 mb-4">
                        <span class="w-2 h-8 bg-[#5e3b69] rounded-full"></span>
                        <h2
                            class="text-4xl font-bold text-[#3d3d47]"
                            id="vision"
                        >
                            Visión
                        </h2>
                    </div>
                    <p
                        class="text-lg text-[#3d3d47] leading-relaxed mb-6 font-medium"
                    >
                        Consolidar una plataforma para el empoderamiento
                        jurídico regional.
                    </p>
                    <div
                        class="space-y-4 text-[#3d3d47]/80 leading-relaxed text-pretty"
                    >
                        <p>
                            ILSA se proyecta como un referente ineludible en
                            América Latina por sus aportes en investigación
                            social y su contribución al pluralismo jurídico,
                            ofreciendo marcos analíticos para enfrentar la
                            complejidad de los retos políticos contemporáneos.
                        </p>
                        <p>
                            Aspiramos a profundizar nuestra articulación en el
                            acompañamiento a las luchas sociales, afianzando la
                            defensa por la vida, el reconocimiento de las
                            territorialidades y la justicia socioclimática
                            frente a las dinámicas del capital.
                        </p>
                    </div>
                </div>
            </section>

            <!-- CAMPOS DE ACCION -->
            <section class="mb-32 max-w-7xl mx-auto">
                <div
                    class="flex flex-col md:flex-row items-center gap-12 lg:gap-16 p-6 md:p-12 rounded-[2.5rem] bg-white/50 backdrop-blur-3xl border border-white/60 shadow-xl shadow-slate-200/50"
                >
                    <div class="w-full md:w-5/12 shrink-0">
                        <AutoSlider
                            class="aspect-square md:aspect-[4/5] rounded-2xl shadow-2xl shadow-blue-900/10"
                            slides={camposImages}
                            alt="Campos de acción e intervención territorial de ILSA"
                        />
                    </div>

                    <!-- Right: Content -->
                    <div class="w-full md:w-7/12">
                        <p
                            class="text-[#4e7cce] font-bold text-sm tracking-widest uppercase mb-2"
                        >
                            Horizontes de Trabajo
                        </p>
                        <h2
                            class="text-3xl md:text-4xl font-bold text-[#3d3d47] mb-6"
                        >
                            Campos de Acción Institucional 2026-2027
                        </h2>
                        <p
                            class="text-[#3d3d47]/70 text-base leading-relaxed mb-8"
                        >
                            Para el periodo 2026-2027, el trabajo de ILSA se ha
                            configurado alrededor de cuatro campos fundamentales
                            que guían nuestras intervenciones y programas
                            misionales para responder a la complejidad de los
                            conflictos socioterritoriales.
                        </p>

                        <!-- Accordion Items -->
                        <div class="space-y-3">
                            <AccordionItem
                                variant="light"
                                title="Conflicto interno y política de paz: derechos de las víctimas, acuerdos y justicia transicional"
                                isOpen={true}
                            >
                                <ul class="list-none space-y-2 text-[#3d3d47] text-sm leading-relaxed">
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">1.</span>
                                        <span>Derechos de las víctimas a la verdad, la justicia, la reparación y garantías de no repetición</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">2.</span>
                                        <span>Negociaciones e implementación integral de acuerdos de paz.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">3.</span>
                                        <span>Territorios de confrontación y de paz</span>
                                    </li>
                                </ul>
                            </AccordionItem>
                            <AccordionItem
                                variant="light"
                                title="Producción del territorio y conflictividades. Territorialidades del capital y alternativas"
                            >
                                <ul class="list-none space-y-2 text-[#3d3d47] text-sm leading-relaxed">
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">1.</span>
                                        <span>Empresas, conflictos socioambientales y derechos humanos</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">2.</span>
                                        <span>Derechos de la Naturaleza, derechos socioambientales y justicia climática.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">3.</span>
                                        <span>Territorialidades, derecho a la alimentación adecuada, agroecología y soberanía alimentaria.</span>
                                    </li>
                                </ul>
                            </AccordionItem>
                            <AccordionItem
                                variant="light"
                                title="Democracias contemporáneas, luchas sociales y derechos humanos"
                            >
                                <ul class="list-none space-y-2 text-[#3d3d47] text-sm leading-relaxed">
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">1.</span>
                                        <span>Sujetos de especial protección, acceso a la justicia, políticas públicas y luchas por la dignidad y el bienestar.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">2.</span>
                                        <span>Configuraciones de las democracias y del Estado hoy.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">3.</span>
                                        <span>Movilización popular, criminalización y participación ciudadana.</span>
                                    </li>
                                </ul>
                            </AccordionItem>
                            <AccordionItem
                                variant="light"
                                title="Género, derechos de las mujeres y diversidades"
                            >
                                <ul class="list-none space-y-2 text-[#3d3d47] text-sm leading-relaxed">
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">1.</span>
                                        <span>Participación política paritaria, organización y movilización social.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">2.</span>
                                        <span>Economía, cuidados y género.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">3.</span>
                                        <span>Mujeres, diversidades, derecho y justicia</span>
                                    </li>
                                </ul>
                            </AccordionItem>
                        </div>
                    </div>
                </div>
            </section>

            <!-- DIRECCION EJECUTIVA SECTION -->
            <section class="max-w-7xl mx-auto mb-24">
                <div class="text-center mb-12">
                    <h2
                        class="text-4xl font-bold text-center text-[#3d3d47] mb-4 mx-auto"
                        id="direccion-ejecutiva"
                    >
                        Dirección Ejecutiva
                    </h2>
                    <div class="w-16 h-1 bg-[#4e7cce] mx-auto rounded-full">
                    </div>
                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6"
                >
                    {
                        teamData.map((member, index) => (
                            <div
                                class={`interactive-card relative group rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl cursor-pointer h-[400px] md:h-[450px] w-full focus-visible:ring-2 focus-visible:ring-[#4e7cce] focus-visible:ring-offset-2 outline-none ${index === 0 ? "ring-2 ring-white/40 shadow-[#4e7cce]/20" : ""}`}
                                data-team-id={member.id}
                                tabindex="0"
                                role="button"
                            >
                                <img
                                    class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-110"
                                    src={member.image}
                                    alt={member.name}
                                    width="400"
                                    height="450"
                                    loading="lazy"
                                />

                                {/* Insignia elegante "Liquid Glass" exclusiva para la Dirección Ejecutiva */}
                                {index === 0 && (
                                    <div class="absolute top-4 right-4 z-20 bg-white/20 backdrop-blur-md border border-white/40 rounded-full p-2.5 shadow-lg group-hover:bg-white/30 transition-colors duration-300 pointer-events-none">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="18"
                                            height="18"
                                            viewBox="0 0 24 24"
                                            class="drop-shadow-[0_0_8px_rgba(250,204,21,0.6)]"
                                        >
                                            <defs>
                                                <linearGradient
                                                    id="gold-grad"
                                                    x1="0%"
                                                    y1="0%"
                                                    x2="100%"
                                                    y2="100%"
                                                >
                                                    <stop
                                                        offset="0%"
                                                        stop-color="#FEF08A"
                                                    />
                                                    <stop
                                                        offset="40%"
                                                        stop-color="#F59E0B"
                                                    />
                                                    <stop
                                                        offset="100%"
                                                        stop-color="#A16207"
                                                    />
                                                </linearGradient>
                                            </defs>
                                            <polygon
                                                fill="url(#gold-grad)"
                                                stroke="#FEF08A"
                                                stroke-width="1.5"
                                                stroke-linejoin="round"
                                                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                                            />
                                        </svg>
                                    </div>
                                )}

                                <div
                                    class={`absolute inset-0 bg-gradient-to-t opacity-90 transition-opacity duration-300 ${index === 0 ? "from-[#0b1b42] via-[#102352]/50 to-transparent" : "from-[#183069] via-[#183069]/40 to-transparent"}`}
                                />
                                <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                    <p
                                        class={`font-bold text-xs tracking-widest uppercase mb-1 opacity-80 group-hover:opacity-100 text-center shrink-0 ${index === 0 ? "text-[#a1c4ff]" : "text-[#efefef]"}`}
                                    >
                                        {member.role}
                                    </p>
                                    <div class="h-14 md:h-16 flex items-center justify-center w-full mb-2 shrink-0">
                                        <h3
                                            class={`font-bold text-center text-white leading-tight drop-shadow-md ${member.name.length > 20 ? "text-lg md:text-xl" : "text-xl md:text-2xl"}`}
                                        >
                                            {member.name}
                                        </h3>
                                    </div>
                                    <div class="h-0 group-hover:h-auto overflow-hidden transition-all duration-500 opacity-0 group-hover:opacity-100 text-center">
                                        <p class="text-slate-300 text-sm mt-2">
                                            {member.bio || ""}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- BOARD SECTION -->
            <section class="max-w-7xl mx-auto mb-24">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl font-bold text-center text-[#3d3d47] mb-4 mx-auto"
                        id="junta-directiva"
                    >
                        Junta Directiva de ILSA
                    </h2>
                    <div class="w-16 h-1 bg-[#4e7cce] mx-auto rounded-full">
                    </div>
                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6"
                >
                    {
                        boardData.map((member, index) => (
                            <div
                                class={`interactive-card relative group rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl cursor-pointer h-[400px] md:h-[450px] w-full focus-visible:ring-2 focus-visible:ring-[#4e7cce] focus-visible:ring-offset-2 outline-none ${index === 0 ? "ring-2 ring-white/40 shadow-[#4e7cce]/20" : ""}`}
                                data-team-id={member.id}
                                tabindex="0"
                                role="button"
                            >
                                <img
                                    class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-110"
                                    src={member.image}
                                    alt={member.name}
                                    width="400"
                                    height="450"
                                    loading="lazy"
                                />

                                {/* Insignia elegante "Liquid Glass" exclusiva para la Presidencia */}
                                {index === 0 && (
                                    <div class="absolute top-4 right-4 z-20 bg-white/20 backdrop-blur-md border border-white/40 rounded-full p-2.5 shadow-lg group-hover:bg-white/30 transition-colors duration-300 pointer-events-none">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="18"
                                            height="18"
                                            viewBox="0 0 24 24"
                                            class="drop-shadow-[0_0_8px_rgba(250,204,21,0.6)]"
                                        >
                                            <defs>
                                                <linearGradient
                                                    id="gold-grad-board"
                                                    x1="0%"
                                                    y1="0%"
                                                    x2="100%"
                                                    y2="100%"
                                                >
                                                    <stop
                                                        offset="0%"
                                                        stop-color="#FEF08A"
                                                    />
                                                    <stop
                                                        offset="40%"
                                                        stop-color="#F59E0B"
                                                    />
                                                    <stop
                                                        offset="100%"
                                                        stop-color="#A16207"
                                                    />
                                                </linearGradient>
                                            </defs>
                                            <polygon
                                                fill="url(#gold-grad-board)"
                                                stroke="#FEF08A"
                                                stroke-width="1.5"
                                                stroke-linejoin="round"
                                                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                                            />
                                        </svg>
                                    </div>
                                )}

                                <div
                                    class={`absolute inset-0 bg-gradient-to-t opacity-90 transition-opacity duration-300 ${index === 0 ? "from-[#0b1b42] via-[#102352]/50 to-transparent" : "from-[#183069] via-[#183069]/40 to-transparent"}`}
                                />
                                <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                    <p
                                        class={`font-bold text-xs tracking-widest uppercase mb-1 opacity-80 group-hover:opacity-100 text-center shrink-0 ${index === 0 ? "text-[#a1c4ff]" : "text-[#efefef]"}`}
                                    >
                                        {member.role}
                                    </p>
                                    <div class="h-14 md:h-16 flex items-center justify-center w-full mb-2 shrink-0">
                                        <h3
                                            class={`font-bold text-center text-white leading-tight drop-shadow-md ${member.name.length > 20 ? "text-lg md:text-xl" : "text-xl md:text-2xl"}`}
                                        >
                                            {member.name}
                                        </h3>
                                    </div>
                                    <div class="h-0 group-hover:h-auto overflow-hidden transition-all duration-500 opacity-0 group-hover:opacity-100 text-center">
                                        <p class="text-slate-300 text-sm mt-2">
                                            {member.bio || ""}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- ASAMBLEA SECTION -->
            <section class="max-w-7xl mx-auto mb-24">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl font-bold text-center text-[#3d3d47] mb-4 mx-auto"
                        id="asamblea"
                    >
                        Integrantes de la Asamblea de Socias y Socios de ILSA
                    </h2>
                    <div
                        class="w-16 h-1 bg-[#4e7cce] mx-auto rounded-full mb-8"
                    >
                    </div>
                    <p
                        class="text-[#3d3d47]/70 text-center text-base max-w-2xl mx-auto mb-8 text-balance"
                    >
                        Órgano máximo de dirección y decisión, integrado por
                        personas comprometidas con la misión institucional y la
                        defensa de los derechos.
                    </p>
                </div>

                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
                    {
                        assemblyData.map((member) => (
                            <div class="flex items-center gap-4 bg-white/50 backdrop-blur-xl border border-white/60 p-4 rounded-2xl shadow-sm hover:shadow-md transition-shadow duration-300">
                                <img
                                    src={member.image}
                                    alt={member.name}
                                    width="48"
                                    height="48"
                                    class="w-12 h-12 rounded-full object-cover shadow-inner"
                                    loading="lazy"
                                />
                                <div>
                                    <h3 class="text-sm font-bold text-center text-[#3d3d47] leading-tight mb-1">
                                        {member.name}
                                    </h3>
                                    <p class="text-[10px] text-center text-[#4e7cce] font-bold uppercase tracking-wider">
                                        {member.role}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- EQUIPO DE TRABAJO SECTION -->
            <section class="mb-32 max-w-7xl mx-auto rounded-[2.5rem] border border-white/60 bg-white/40 p-6 backdrop-blur-md md:p-10 lg:p-12">
                <div class="text-center mb-10">
                    <h2
                        class="text-4xl font-bold text-center text-[#3d3d47] mb-4 mx-auto"
                        id="equipo-trabajo"
                    >
                        Equipo de Trabajo
                    </h2>
                    <div class="w-16 h-1 bg-[#4e7cce] mx-auto rounded-full">
                    </div>
                </div>

                <WorkTeamTabs />
            </section>

            <!-- MANUAL DE MARCA CTA SECTION -->
            <section
                id="identidad-visual"
                class="max-w-7xl mx-auto mb-24 relative overflow-hidden rounded-[2.5rem] bg-white/50 backdrop-blur-3xl border border-white/60 shadow-xl shadow-slate-200/50 p-8 md:p-12 lg:p-16 flex flex-col md:flex-row items-center gap-8 md:gap-16"
            >
                <!-- Background decor -->
                <div
                    class="absolute -top-32 -right-32 w-64 h-64 bg-[#4e7cce]/20 rounded-full blur-[80px] pointer-events-none"
                >
                </div>
                <div
                    class="absolute -bottom-32 -left-32 w-64 h-64 bg-[#183069]/20 rounded-full blur-[80px] pointer-events-none"
                >
                </div>

                <div class="w-full md:w-1/2 relative z-10">
                    <p
                        class="text-[#4e7cce] font-bold text-sm tracking-widest uppercase mb-2"
                    >
                        Marca Corporativa
                    </p>
                    <GradientText
                        as="h2"
                        text="Identidad Visual"
                        size="text-3xl md:text-5xl"
                        class="mb-6"
                    />
                    <p
                        class="text-[#3d3d47]/70 text-base md:text-lg leading-relaxed mb-8"
                    >
                        Nuestra identidad gráfica refleja la evolución, la
                        experiencia y los valores fundamentales de ILSA. Explora
                        nuestro manual para conocer las directrices de uso de
                        nuestras marcas, tipografía corporativa y paleta de
                        colores.
                    </p>
                    <Button
                        variant="primary"
                        size="lg"
                        href="/nosotros/manual-marca"
                        class="gap-2 group relative z-20"
                        {...{ "data-astro-reload": true }}
                    >
                        Ver Manual de Identidad
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 transform group-hover:translate-x-1 transition-transform"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </Button>
                </div>

                <div class="w-full md:w-1/2 relative z-10 flex justify-center">
                    <div
                        class="relative w-full max-w-sm aspect-square bg-[#f9f9f9] rounded-2xl p-8 shadow-inner border border-gray-100 flex items-center justify-center transform hover:scale-105 transition-transform duration-500"
                    >
                        <img
                            src="/images/ILSA-LOGO-20.png"
                            alt="ILSA Logotipo"
                            width="400"
                            height="400"
                            class="w-full h-auto object-contain drop-shadow-md rounded-xl"
                        />

                        <div
                            class="absolute -top-4 -right-4 w-12 h-12 bg-white rounded-lg shadow-lg flex items-center justify-center motion-safe:animate-bounce border border-gray-100 overflow-hidden p-1"
                            style="animation-duration: 3s;"
                        >
                            <img
                                src="/ILSA-M.svg"
                                alt="ILSA monograma"
                                width="48"
                                height="48"
                                class="w-full h-full object-contain"
                            />
                        </div>
                        <div
                            class="absolute -bottom-4 -left-4 w-16 h-12 bg-[#93a2c1] rounded-lg shadow-lg flex items-center justify-center motion-safe:animate-bounce"
                            style="animation-duration: 4s; animation-delay: 1s;"
                        >
                            <div class="w-8 h-4 bg-[#5e3b69]/40 rounded"></div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
        <TeamModal />
    </div>
</Layout>
