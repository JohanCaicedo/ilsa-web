---
import Layout from "../../layouts/Layout.astro";
import AccordionItem from "../../components/atoms/AccordionItem.astro";
import TeamModal from "../../components/molecules/TeamModal.astro";
import WorkTeamTabs from "../../components/molecules/WorkTeamTabs.astro";
import ColombiaMap from "../../components/organisms/ColombiaMap.astro";
import Button from "../../components/Button.astro";
import GradientText from "../../components/atoms/GradientText.astro";
import AutoSlider from "../../components/molecules/AutoSlider.astro";
import HistoryTimeline from "../../components/organisms/HistoryTimeline.astro";
import TeamCardNosotros from "../../components/molecules/TeamCardNosotros.astro";
import { wpQuery } from "../../lib/wp";
import { teamData, boardData, assemblyData, workTeamAreas } from "../../lib/team";

const allMembers = [
    ...teamData,
    ...boardData,
    ...assemblyData,
    ...workTeamAreas.flatMap((area) => area.members),
];
import type { SeoData } from "../../lib/seo";

const heroImages = [
    "/images/gallery/Nosotros (5).webp",
    "/images/gallery/Nosotros (6).webp",
    "/images/gallery/Nosotros (7).webp",
    "/images/gallery/Nosotros (12).webp",
    "/images/gallery/Nosotros (14).webp",
];

const geoImages = [
    "/images/gallery/HomeGalery (1).webp",
    "/images/gallery/Nosotros (1).webp",
    "/images/gallery/Nosotros (8).webp",
    "/images/gallery/Nosotros (15).webp",
];

const missionImages = [
    "/images/gallery/HomeGalery (2).webp",
    "/images/gallery/Nosotros (2).webp",
    "/images/gallery/Nosotros (9).webp",
    "/images/gallery/HomeGalery (6).webp",
];

const visionImages = [
    "/images/gallery/HomeGalery (3).webp",
    "/images/gallery/Nosotros (3).webp",
    "/images/gallery/Nosotros (10).webp",
    "/images/gallery/Nosotros (13).webp",
];

const camposImages = [
    "/images/gallery/HomeGalery (4).webp",
    "/images/gallery/HomeGalery (5).webp",
    "/images/gallery/Nosotros (4).webp",
    "/images/gallery/Nosotros (11).webp",
];

export const prerender = true;

const breadcrumbItems = [{ label: "Nosotros", href: "/nosotros" }];

// Fetch SEO Data specifically for this page
const data = await wpQuery({
    query: `
    query GetNosotrosSEO {
      page(id: "/nosotros", idType: URI) {
        seo {
          title
          metaDesc
          canonical
          opengraphTitle
          opengraphDescription
          opengraphImage {
            sourceUrl
          }
          twitterTitle
          twitterDescription
          twitterImage {
             sourceUrl
          }
        }
      }
    }
  `,
});

const seoData: SeoData = data?.page?.seo;
---

<Layout seo={seoData} breadcrumbs={breadcrumbItems}>
    <div
        class="relative min-h-screen text-[#3d3d47] overflow-hidden overflow-x-hidden font-sans"
    >
        <!-- Global Atmosphere Gradients (Cool & Clean) -->
        <div class="fixed top-0 left-0 w-full h-full pointer-events-none z-0">
            <!-- Enhanced Blue/Coolness -->
            <div
                class="absolute top-[-20%] right-[-10%] w-[50%] h-[50%] bg-[#4e7cce]/5 rounded-full blur-[120px]"
            >
            </div>
            <div
                class="absolute bottom-[-10%] left-[-10%] w-[50%] h-[50%] bg-[#4e7cce]/5 rounded-full blur-[120px]"
            >
            </div>
        </div>

        <div class="relative z-10 pt-8 pb-24 px-6 md:px-12 max-w-7xl mx-auto">
            <!-- HERO SECTION -->
            <section
                id="historia"
                class="mb-24 flex flex-col items-center text-center max-w-5xl mx-auto scroll-mt-32"
            >
                <!-- Badge -->
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-[#4e7cce]/20 shadow-sm mb-8"
                >
                    <span class="relative flex h-3 w-3">
                        <span
                            class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-[#4e7cce] opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-3 w-3 bg-[#4e7cce]"
                        ></span>
                    </span>
                    <span
                        class="text-xs md:text-sm font-bold text-[#4e7cce] uppercase tracking-widest"
                    >
                        Fundado en 1978
                    </span>
                </div>

                <!-- Headline -->
                <h1
                    class="text-5xl md:text-6xl lg:text-7xl font-bold text-center text-[#3d3d47] mb-8 tracking-tight leading-[1.1] text-balance"
                >
                    <span class="text-[#4e7cce]">Derecho Alternativo</span>
                </h1>

                <!-- Lead -->
                <p
                    class="text-md md:text-lg text-[#3d3d47]/80 max-w-3xl mx-auto leading-relaxed mb-12 text-pretty"
                >
                    Organización no gubernamental que impulsa el derecho como herramienta de transformación social y de justicia en Colombia y América Latina.
                </p>

                <!-- Hero Image -->
                <AutoSlider
                    class="w-full h-[400px] md:h-[500px] mb-16 rounded-[2.5rem] shadow-2xl shadow-blue-900/10"
                    srcs={heroImages}
                    alt="Territorio y Naturaleza"
                    width={1200}
                    height={500}
                />

                <!-- Feature Grid -->
                <div class="grid md:grid-cols-3 gap-8 w-full text-left">
                    <div
                        class="p-8 rounded-2xl bg-white border border-slate-100 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:shadow-[#4e7cce]/10 transition-all duration-300 group"
                    >
                        <div
                            class="w-12 h-12 rounded-lg bg-blue-50 text-[#4e7cce] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                        </div>
                        <h3 class="text-xl font-bold text-[#3d3d47] mb-3">
                            Trayectoria Regional
                        </h3>
                        <p class="text-[#3d3d47]/70 text-sm leading-relaxed">
                            Con sede en Bogotá y presencia en América Latina y el Caribe, ILSA cuenta con décadas de experiencia en investigación sociopolítica.
                        </p>
                    </div>

                    <div
                        class="p-8 rounded-2xl bg-white border border-slate-100 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:shadow-[#5e3b69]/10 transition-all duration-300 group"
                    >
                        <div
                            class="w-12 h-12 rounded-lg bg-purple-50 text-[#5e3b69] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                                ></path></svg
                            >
                        </div>
                        <h3 class="text-xl font-bold text-[#3d3d47] mb-3">
                            Servicio Jurídico Crítico
                        </h3>
                        <p class="text-[#3d3d47]/70 text-sm leading-relaxed">
                            Formación y acompañamiento jurídico a sectores populares y a sus procesos organizativos.
                        </p>
                    </div>

                    <div
                        class="p-8 rounded-2xl bg-white border border-slate-100 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:shadow-[#e9b384]/20 transition-all duration-300 group"
                    >
                        <div
                            class="w-12 h-12 rounded-lg bg-orange-50 text-[#e9b384] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                                ></path></svg
                            >
                        </div>
                        <h3 class="text-xl font-bold text-[#3d3d47] mb-3">
                            Ecología de Saberes
                        </h3>
                        <p class="text-[#3d3d47]/70 text-sm leading-relaxed">
                            Diálogo entre las ciencias sociales y otras áreas del saber para el estudio de problemas sociales complejos.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Divider -->
            <div
                class="w-full h-px bg-gradient-to-r from-transparent via-[#3d3d47]/10 to-transparent mb-24"
            >
            </div>

            <!-- HISTORIA INSTITUCIONAL - Scroll Timeline -->
            <HistoryTimeline />

            <!-- GEO PRESENCE -->
            <section class="max-w-7xl mx-auto mb-24 text-center">
                <h2 class="text-3xl font-bold text-[#3d3d47] mb-8 text-center">
                    Presencia Geográfica
                </h2>

                <div class="flex flex-col items-center gap-8">
                    <!-- Mapa + texto (centrado, 2/3 del ancho) -->
                    <div class="w-full md:w-2/3 flex flex-col gap-4">
                        <ColombiaMap />
                        <p
                            class="text-[#3d3d47]/70 italic text-sm leading-relaxed"
                        >
                            Despliegue de trabajo situado y adaptado
                            culturalmente en el Ariari (Meta), Costa Pacífica
                            (Cauca), Páramo de Pisba (Boyacá), Urabá
                            (Antioquia), Provincia de Vélez (Santander), Laguna
                            de La Cocha (Nariño), Trapecio Amazónico, Montes de
                            María y el Archipiélago.
                        </p>
                    </div>

                    <!-- Carrusel debajo, ancho completo -->
                    <AutoSlider
                        class="w-full h-[280px] md:h-[350px] rounded-3xl shadow-lg border border-white/50"
                        srcs={geoImages}
                        alt="Ubicación Geográfica ILSA"
                        width={1200}
                        height={500}
                    />
                </div>
            </section>

            <!-- MISSION / VISION -->
            <section class="grid md:grid-cols-2 gap-12 mb-32 items-center">
                <!-- Mission Content -->
                <div class="order-2 md:order-1">
                    <div class="inline-flex items-center gap-2 mb-4">
                        <span class="w-2 h-8 bg-[#4e7cce] rounded-full"></span>
                        <h2
                            class="text-4xl font-bold text-[#3d3d47]"
                            id="mision"
                        >
                            Misión
                        </h2>
                    </div>
                    <p
                        class="text-lg text-[#3d3d47] leading-relaxed mb-6 font-medium"
                    >
                        Promover una práctica crítica del derecho desde el
                        horizonte de los servicios legales alternativos.
                    </p>
                    <div
                        class="space-y-4 text-[#3d3d47]/80 leading-relaxed text-pretty"
                    >
                        <p>
                            ILSA se constituye como un centro de
                            investigación-acción orientado a consolidar una
                            concepción integral de los derechos humanos.
                            Buscamos romper con las lógicas tradicionales de la
                            práctica jurídica, articulando el pensamiento
                            crítico con la acción sociopolítica de los sectores
                            populares.
                        </p>
                        <p>
                            A través del servicio jurídico crítico y la
                            educación jurídica popular, contribuimos en la
                            construcción de procesos de exigibilidad para
                            asociaciones campesinas, pueblos indígenas,
                            comunidades afro, procesos de mujeres y población
                            firmante de paz.
                        </p>
                    </div>
                </div>

                <!-- Mission Image -->
                <AutoSlider
                    class="order-1 md:order-2 w-full h-[450px] rounded-[2.5rem] shadow-xl shadow-blue-900/10"
                    srcs={missionImages}
                    alt="Trabajo comunitario de ILSA con movimientos sociales"
                    width={800}
                    height={450}
                />

                <!-- Vision Image -->
                <AutoSlider
                    class="w-full h-[450px] rounded-[2.5rem] shadow-xl shadow-purple-900/10"
                    srcs={visionImages}
                    alt="Territorios y comunidades que defiende ILSA"
                    width={800}
                    height={450}
                />

                <!-- Vision Content -->
                <div>
                    <div class="inline-flex items-center gap-2 mb-4">
                        <span class="w-2 h-8 bg-[#5e3b69] rounded-full"></span>
                        <h2
                            class="text-4xl font-bold text-[#3d3d47]"
                            id="vision"
                        >
                            Visión
                        </h2>
                    </div>
                    <p
                        class="text-lg text-[#3d3d47] leading-relaxed mb-6 font-medium"
                    >
                        Consolidar una plataforma para el empoderamiento
                        jurídico regional.
                    </p>
                    <div
                        class="space-y-4 text-[#3d3d47]/80 leading-relaxed text-pretty"
                    >
                        <p>
                            ILSA se proyecta como un referente ineludible en
                            América Latina por sus aportes en investigación
                            social y su contribución al pluralismo jurídico,
                            ofreciendo marcos analíticos para enfrentar la
                            complejidad de los retos políticos contemporáneos.
                        </p>
                        <p>
                            Aspiramos a profundizar nuestra articulación en el
                            acompañamiento a las luchas sociales, afianzando la
                            defensa por la vida, el reconocimiento de las
                            territorialidades y la justicia socioclimática
                            frente a las dinámicas del capital.
                        </p>
                    </div>
                </div>
            </section>

            <!-- CAMPOS DE ACCION -->
            <section class="mb-32 max-w-7xl mx-auto">
                <div
                    class="flex flex-col md:flex-row items-center gap-12 lg:gap-16 p-6 md:p-12 rounded-[2.5rem] bg-white/50 backdrop-blur-3xl border border-white/60 shadow-xl shadow-slate-200/50"
                >
                    <div class="w-full md:w-5/12 shrink-0">
                        <AutoSlider
                            class="group rounded-2xl shadow-2xl shadow-blue-900/10 aspect-square md:aspect-[4/5]"
                            srcs={camposImages}
                            alt="Campos de acción e intervención territorial de ILSA"
                            width={800}
                            height={900}
                        />
                    </div>

                    <!-- Right: Content -->
                    <div class="w-full md:w-7/12">
                        <p
                            class="text-[#4e7cce] font-bold text-sm tracking-widest uppercase mb-2"
                        >
                            Horizontes de Trabajo
                        </p>
                        <h2
                            class="text-3xl md:text-4xl font-bold text-[#3d3d47] mb-6"
                        >
                            Campos de Acción Institucional 2026-2027
                        </h2>
                        <p
                            class="text-[#3d3d47]/70 text-base leading-relaxed mb-8"
                        >
                            Para el periodo 2026-2027, el trabajo de ILSA se ha
                            configurado alrededor de cuatro campos fundamentales
                            que guían nuestras intervenciones y programas
                            misionales para responder a la complejidad de los
                            conflictos socioterritoriales.
                        </p>

                        <!-- Accordion Items -->
                        <div class="space-y-3">
                            <AccordionItem
                                variant="light"
                                title="Conflicto interno y política de paz: derechos de las víctimas, acuerdos y justicia transicional"
                                isOpen={true}
                            >
                                <ul class="list-none space-y-2 text-[#3d3d47] text-sm leading-relaxed">
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">1.</span>
                                        <span>Derechos de las víctimas a la verdad, la justicia, la reparación y garantías de no repetición</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">2.</span>
                                        <span>Negociaciones e implementación integral de acuerdos de paz.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">3.</span>
                                        <span>Territorios de confrontación y de paz</span>
                                    </li>
                                </ul>
                            </AccordionItem>
                            <AccordionItem
                                variant="light"
                                title="Producción del territorio y conflictividades. Territorialidades del capital y alternativas"
                            >
                                <ul class="list-none space-y-2 text-[#3d3d47] text-sm leading-relaxed">
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">1.</span>
                                        <span>Empresas, conflictos socioambientales y derechos humanos</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">2.</span>
                                        <span>Derechos de la Naturaleza, derechos socioambientales y justicia climática.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">3.</span>
                                        <span>Territorialidades, derecho a la alimentación adecuada, agroecología y soberanía alimentaria.</span>
                                    </li>
                                </ul>
                            </AccordionItem>
                            <AccordionItem
                                variant="light"
                                title="Democracias contemporáneas, luchas sociales y derechos humanos"
                            >
                                <ul class="list-none space-y-2 text-[#3d3d47] text-sm leading-relaxed">
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">1.</span>
                                        <span>Sujetos de especial protección, acceso a la justicia, políticas públicas y luchas por la dignidad y el bienestar.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">2.</span>
                                        <span>Configuraciones de las democracias y del Estado hoy.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">3.</span>
                                        <span>Movilización popular, criminalización y participación ciudadana.</span>
                                    </li>
                                </ul>
                            </AccordionItem>
                            <AccordionItem
                                variant="light"
                                title="Género, derechos de las mujeres y diversidades"
                            >
                                <ul class="list-none space-y-2 text-[#3d3d47] text-sm leading-relaxed">
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">1.</span>
                                        <span>Participación política paritaria, organización y movilización social.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">2.</span>
                                        <span>Economía, cuidados y género.</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="font-bold text-[#4e7cce] mt-0.5">3.</span>
                                        <span>Mujeres, diversidades, derecho y justicia</span>
                                    </li>
                                </ul>
                            </AccordionItem>
                        </div>
                    </div>
                </div>
            </section>

            <!-- DIRECCION EJECUTIVA SECTION -->
            <section class="max-w-7xl mx-auto mb-24">
                <div class="text-center mb-12">
                    <h2
                        class="text-4xl font-bold text-center text-[#3d3d47] mb-4 mx-auto"
                        id="direccion-ejecutiva"
                    >
                        Dirección Ejecutiva
                    </h2>
                    <div class="w-16 h-1 bg-[#4e7cce] mx-auto rounded-full">
                    </div>
                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6"
                >
                    {
                        teamData.map((member, index) => (
                            <TeamCardNosotros
                                name={member.name}
                                role={member.role}
                                image={member.image}
                                bio={member.bio}
                                id={member.id}
                                variant={index === 0 ? "highlight" : "default"}
                                index={index}
                            />
                        ))
                    }
                </div>
            </section>

            <!-- BOARD SECTION -->
            <section class="max-w-7xl mx-auto mb-24">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl font-bold text-center text-[#3d3d47] mb-4 mx-auto"
                        id="junta-directiva"
                    >
                        Junta Directiva de ILSA
                    </h2>
                    <div class="w-16 h-1 bg-[#4e7cce] mx-auto rounded-full">
                    </div>
                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6"
                >
                    {
                        boardData.map((member, index) => (
                            <TeamCardNosotros
                                name={member.name}
                                role={member.role}
                                image={member.image}
                                bio={member.bio}
                                id={member.id}
                                variant={index === 0 ? "highlight" : "default"}
                                index={index}
                            />
                        ))
                    }
                </div>
            </section>

            <!-- ASAMBLEA SECTION -->
            <section class="max-w-7xl mx-auto mb-24">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl font-bold text-center text-[#3d3d47] mb-4 mx-auto"
                        id="asamblea"
                    >
                        Integrantes de la Asamblea de Socias y Socios
                    </h2>
                    <div
                        class="w-16 h-1 bg-[#4e7cce] mx-auto rounded-full mb-8"
                    >
                    </div>
                </div>

                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
                    {
                        assemblyData.map((member) => (
                            <div class="flex items-center gap-4 bg-white/50 backdrop-blur-xl border border-white/60 p-4 rounded-2xl shadow-sm hover:shadow-md transition-shadow duration-300">
                                <img
                                    src={member.image}
                                    alt={member.name}
                                    width="48"
                                    height="48"
                                    class="w-12 h-12 rounded-full object-cover shadow-inner"
                                    loading="lazy"
                                />
                                <div>
                                    <h3 class="text-sm font-bold text-center text-[#3d3d47] leading-tight mb-1">
                                        {member.name}
                                    </h3>
                                    <p class="text-[10px] text-center text-[#4e7cce] font-bold uppercase tracking-wider">
                                        {member.role}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- EQUIPO DE TRABAJO SECTION -->
            <section class="mb-32 max-w-7xl mx-auto rounded-[2.5rem] border border-white/60 bg-white/40 p-6 backdrop-blur-md md:p-10 lg:p-12">
                <div class="text-center mb-10">
                    <h2
                        class="text-4xl font-bold text-center text-[#3d3d47] mb-4 mx-auto"
                        id="equipo-trabajo"
                    >
                        Equipo de Trabajo
                    </h2>
                    <div class="w-16 h-1 bg-[#4e7cce] mx-auto rounded-full">
                    </div>
                </div>

